---
/*
 * Every <head> tag that is not page content. One component so a new marketing page cannot ship
 * without a canonical URL, an OG image and the analytics decision.
 */
interface Props {
	title: string;
	description: string;
	image?: string;
	jsonLd?: Record<string, unknown>;
	/* The styleguide and other review-only pages: kept out of search results. */
	noindex?: boolean;
}
const {
	title,
	description,
	image = '/og/default.png',
	jsonLd,
	noindex = false
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const plausible = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="FoxAuth" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogImage.href} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.href} />
{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
{
	plausible && (
		<script is:inline defer data-domain={plausible} src="https://plausible.io/js/script.js" />
	)
}
