---
import Site from '../layouts/Site.astro';
import Button from '../components/ui/Button.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
---

<Site
	title="Page not found — FoxAuth"
	description="There is nothing at this address. The home page and the documentation search are the quickest way back to whatever you were after."
	noindex
>
	<Section narrow>
		<Eyebrow>404</Eyebrow>
		<h1 class="text-4xl font-[650] leading-[1.15] tracking-tight text-balance">
			Page not found.
		</h1>
		<p class="mt-5 text-lg text-gray-600 dark:text-gray-400">
			Either the link is wrong or the page has moved. If you know roughly what you were after, the
			documentation search will probably get you there faster than guessing at a URL.
		</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<Button href="/">Home</Button>
			<Button href="/docs/" variant="secondary">Documentation</Button>
			<Button href="/docs/reference/endpoints/" variant="ghost">Endpoint reference</Button>
		</div>
	</Section>
</Site>
