---
/*
 * Every <head> tag that is not page content. One component so a new marketing page cannot ship
 * without a canonical URL, an OG image and the analytics decision.
 *
 * The indexing decision is not made here: it comes from the non-indexable list in data/seo.ts,
 * which astro.config.mjs reads for the sitemap filter and scripts/seo/verify.ts checks the built
 * output against. Before that, a page could say "noindex" here while the sitemap advertised it.
 */
import {
	LOCALE_DEFINITIONS,
	cardSlug,
	isIndexable,
	normaliseRoute,
	type LocaleKey
} from '../data/seo.ts';
import { breadcrumbList, crumbsFor, type JsonLd } from '../data/structured.ts';
import { alternatesFor, localizedRoute } from '../i18n/locale.ts';
import { languageScriptSource } from '../i18n/language-script.ts';
import { lastModified } from '../../scripts/seo/lastmod.ts';
import { sourcesFor } from '../../scripts/seo/sources.ts';

interface Props {
	title: string;
	description: string;
	image?: string;
	/* One block or several; breadcrumbs are added automatically below the top level. */
	jsonLd?: JsonLd | JsonLd[];
	/* Overrides the shared list — only for a page kept out of search for a reason of its own. */
	noindex?: boolean;
	/* The visible heading, used as the breadcrumb leaf so it matches what the page shows. */
	breadcrumbLeaf?: string;
	locale?: LocaleKey;
}
const { title, description, image, jsonLd, noindex, breadcrumbLeaf, locale = 'en' } = Astro.props;

const route = normaliseRoute(Astro.url.pathname);
const canonical = new URL(route, Astro.site);
const hidden = noindex ?? !isIndexable(route);

/*
 * The language versions of this page that exist, itself included, with English as the default for
 * every other language. A page with no translation declares none — not even x-default — so the
 * language script has nothing to redirect to and the switcher nothing to offer.
 */
const alternates = hidden ? [] : await alternatesFor(route);
const feed = localizedRoute('/blog/', locale) + 'rss.xml';

/*
 * The per-page card, referenced unconditionally: scripts/seo/cards.ts renders one for every page
 * after the build, when the route set is known. Cards are generated and never committed, so a build
 * with the capture skipped has none — scripts/seo/verify.ts reports the image rule as skipped there
 * rather than passing it silently.
 */
const ogImage = new URL(image ?? `/og/${cardSlug(route)}.png`, Astro.site);

const { sourceFile, dataSources } = sourcesFor(route);
const lastmod = lastModified(sourceFile, dataSources);

const blocks: JsonLd[] = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const crumbs = crumbsFor(route, breadcrumbLeaf ?? title);
if (crumbs.length > 1) blocks.push(breadcrumbList(crumbs));

const plausible = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
---

<meta charset="utf-8" />
<meta
	name="viewport"
	content="width=device-width, initial-scale=1"
/>
<meta
	name="color-scheme"
	content="light dark"
/>
<title>{title}</title>
<meta
	name="description"
	content={description}
/>
<link
	rel="canonical"
	href={canonical.href}
/>
{
	hidden && (
		<meta
			name="robots"
			content="noindex"
		/>
	)
}
{
	lastmod && (
		<meta
			name="last-modified"
			content={lastmod}
		/>
	)
}
<link
	rel="icon"
	href="/favicon.svg"
	type="image/svg+xml"
/>
<link
	rel="icon"
	href="/favicon.ico"
	sizes="32x32"
/>
<link
	rel="sitemap"
	href="/sitemap-index.xml"
/>
{
	/*
	 * Only on the blog: autodiscovery on a page with no feed behind it points a reader's tooling at
	 * something that has nothing to do with what they are reading.
	 */
	route.startsWith(localizedRoute('/blog/', locale)) && (
		<link
			rel="alternate"
			type="application/rss+xml"
			title="FoxAuth blog"
			href={feed}
		/>
	)
}
{
	alternates.map((alternate) => (
		<link
			rel="alternate"
			hreflang={alternate.locale.lang}
			href={new URL(alternate.href, Astro.site).href}
		/>
	))
}
{
	alternates.length > 0 && (
		<link
			rel="alternate"
			hreflang="x-default"
			href={new URL(alternates[0]!.href, Astro.site).href}
		/>
	)
}
{
	!hidden && (
		<link
			rel="alternate"
			type="text/markdown"
			href={`${route === '/' ? '/index' : route.replace(/\/$/, '')}.md`}
		/>
	)
}
<meta
	property="og:type"
	content="website"
/>
<meta
	property="og:site_name"
	content="FoxAuth"
/>
<meta
	property="og:locale"
	content={LOCALE_DEFINITIONS[locale].ogLocale}
/>
<meta
	property="og:title"
	content={title}
/>
<meta
	property="og:description"
	content={description}
/>
<meta
	property="og:url"
	content={canonical.href}
/>
<meta
	property="og:image"
	content={ogImage.href}
/>
<meta
	name="twitter:card"
	content="summary_large_image"
/>
<meta
	name="twitter:title"
	content={title}
/>
<meta
	name="twitter:description"
	content={description}
/>
<meta
	name="twitter:image"
	content={ogImage.href}
/>
{
	blocks.map((block) => (
		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify(block)}
		/>
	))
}
{
	plausible && (
		<script
			is:inline
			defer
			data-domain={plausible}
			src="https://plausible.io/js/script.js"
		/>
	)
}
{/* Last, so the hreflang links above exist when it reads them. */}
<script
	is:inline
	set:html={languageScriptSource()}
/>
