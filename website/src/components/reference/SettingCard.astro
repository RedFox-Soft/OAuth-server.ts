---
import type { SettingEntry } from '../../data/export';

interface Props {
	setting: SettingEntry;
}
const { setting } = Astro.props;
const value = JSON.stringify(setting.value);
---

<article class="not-content my-4 rounded-lg border border-gray-200 p-4 dark:border-gray-700" id={setting.key}>
	<h4 class="m-0 font-mono text-base">
		<a href={`#${setting.key}`}>{setting.key}</a>
	</h4>
	<p class="mt-1 font-medium">{setting.label}</p>
	<p class="mt-1 text-sm text-gray-700 dark:text-gray-300">{setting.summary}</p>
	<dl class="mt-2 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
		<dt class="text-gray-500">Type</dt>
		<dd>{setting.type}{setting.unit ? ` (${setting.unit})` : ''}</dd>
		<dt class="text-gray-500">Default</dt>
		<dd><code>{value}</code></dd>
		{setting.options && (<><dt class="text-gray-500">Options</dt><dd>{setting.options.join(', ')}</dd></>)}
		{setting.dependsOn && (<><dt class="text-gray-500">Requires</dt><dd><code>{setting.dependsOn}</code></dd></>)}
		{setting.risk && (<><dt class="text-gray-500">Risk</dt><dd>Changing this has a security consequence; the console asks for confirmation.</dd></>)}
	</dl>
	<details class="mt-2 text-sm">
		<summary>Details</summary>
		<p class="mt-2 whitespace-pre-line">{setting.description}</p>
	</details>
</article>
