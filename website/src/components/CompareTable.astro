---
import Badge from './ui/Badge.astro';

type Status = 'yes' | 'flag' | 'no' | 'unknown' | 'na';
type Verdict = 'us' | 'them' | 'even' | 'different';

interface Cell {
	status: Status;
	text: string;
}

interface Row {
	dimension: string;
	us: Cell;
	them: Cell;
	verdict: Verdict;
	why: string;
	note?: string;
}

interface Props {
	competitor: string;
	groups: { label: string; rows: Row[] }[];
}

const { competitor, groups } = Astro.props;

/*
 * One glyph per status, the same in every cell, so a column can be scanned without reading. The
 * text beside it carries the specifics; the long quotes from the competitor's documentation live
 * in the row's note so the table stays a table.
 */
const STATUS: Record<Status, { glyph: string; label: string; tone: string }> = {
	yes: { glyph: '●', label: 'Built in', tone: 'text-accent-700 dark:text-accent-200' },
	flag: {
		glyph: '◐',
		label: 'Behind a flag, preview or add-on',
		tone: 'text-accent-700 dark:text-accent-200'
	},
	no: { glyph: '○', label: 'Not available', tone: 'text-gray-400 dark:text-gray-500' },
	unknown: { glyph: '?', label: 'Not documented', tone: 'text-gray-400 dark:text-gray-500' },
	na: { glyph: '—', label: 'Not applicable', tone: 'text-gray-400 dark:text-gray-500' }
};

const verdictLabel: Record<Verdict, string> = {
	us: 'FoxAuth',
	them: competitor,
	even: 'Even',
	different: 'Different goals'
};

const tally = groups
	.flatMap((g) => g.rows)
	.reduce(
		(acc, row) => {
			acc[row.verdict] += 1;
			return acc;
		},
		{ us: 0, them: 0, even: 0, different: 0 } as Record<Verdict, number>
	);
---

<div class="not-prose">
	<dl
		class="mb-4 flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-600 dark:text-gray-400"
		aria-label="Legend"
	>
		{
			(Object.keys(STATUS) as Status[]).map((key) => (
				<div class="flex items-center gap-2">
					<dt class:list={['w-4 text-center font-mono', STATUS[key].tone]} aria-hidden="true">
						{STATUS[key].glyph}
					</dt>
					<dd>{STATUS[key].label}</dd>
				</div>
			))
		}
	</dl>

	<p class="mb-4 text-sm text-gray-600 dark:text-gray-400">
		Row verdicts: <strong class="text-gray-900 dark:text-gray-100">{tally.us}</strong> FoxAuth ·
		<strong class="text-gray-900 dark:text-gray-100">{tally.them}</strong>
		{competitor} · <strong class="text-gray-900 dark:text-gray-100">{tally.even}</strong> even ·
		<strong class="text-gray-900 dark:text-gray-100">{tally.different}</strong> different goals. A
		count is not a recommendation — the rows that matter to you are the ones that count.
	</p>

	<div
		class="overflow-x-auto rounded-card border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800"
	>
		<table class="w-full min-w-[56rem] border-collapse text-sm">
			<thead>
				<tr class="border-b border-gray-200 text-left dark:border-gray-700">
					<th scope="col" class="w-[18%] px-4 py-3 font-semibold">Dimension</th>
					<th scope="col" class="w-[24%] px-4 py-3 font-semibold">FoxAuth</th>
					<th scope="col" class="w-[24%] px-4 py-3 font-semibold">{competitor}</th>
					<th scope="col" class="px-4 py-3 font-semibold">Verdict</th>
				</tr>
			</thead>
			{
				groups.map((group) => (
					<tbody>
						<tr class="bg-gray-50 dark:bg-gray-900">
							<th
								scope="rowgroup"
								colspan="4"
								class="px-4 py-2 text-left text-xs font-semibold tracking-wide text-gray-600 uppercase dark:text-gray-400"
							>
								{group.label}
							</th>
						</tr>
						{group.rows.map((row) => (
							<tr class="border-t border-gray-200 align-top dark:border-gray-700">
								<th scope="row" class="px-4 py-3 text-left font-medium">
									{row.dimension}
								</th>
								{([row.us, row.them] as Cell[]).map((cell) => (
									<td class="px-4 py-3">
										<span class="flex gap-2">
											<span
												class:list={['w-4 shrink-0 text-center font-mono', STATUS[cell.status].tone]}
												title={STATUS[cell.status].label}
												aria-label={STATUS[cell.status].label}
											>
												{STATUS[cell.status].glyph}
											</span>
											<span>{cell.text}</span>
										</span>
									</td>
								))}
								<td class="px-4 py-3">
									<Badge tone={row.verdict === 'us' ? 'accent' : 'neutral'}>
										{verdictLabel[row.verdict]}
									</Badge>
									<p class="mt-1.5 text-gray-700 dark:text-gray-300">{row.why}</p>
									{row.note && (
										<details class="mt-1.5 text-xs text-gray-600 dark:text-gray-400">
											<summary class="cursor-pointer text-accent-700 dark:text-accent-200">
												What their docs say
											</summary>
											<p class="mt-1">{row.note}</p>
										</details>
									)}
								</td>
							</tr>
						))}
					</tbody>
				))
			}
		</table>
	</div>
</div>
