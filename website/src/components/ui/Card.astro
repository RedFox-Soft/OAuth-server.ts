---
interface Props {
	href?: string;
	tone?: 'default' | 'accent';
	/* Anchor target, so a card can be linked to directly (e.g. /pricing/#cloud). */
	id?: string;
	/* `lg` for a card used as a full-width panel, where 24px of padding looks cramped. */
	padding?: 'md' | 'lg';
}
const { href, tone = 'default', id, padding = 'md' } = Astro.props;
const paddings = { md: 'p-6', lg: 'p-8 md:p-12' };
const Tag = href ? 'a' : 'div';
// Section tone="muted" is dark:bg-gray-900 -- a card matching it here would lose its surface on a
// muted section in dark mode, so the card sits one step lighter than that background.
const tones = {
	default: 'border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800',
	accent: 'border-accent-200 bg-accent-50 dark:border-accent-900 dark:bg-gray-800'
};
---

<Tag
	href={href}
	id={id}
	class:list={[
		'block rounded-card border no-underline transition-colors',
		paddings[padding],
		tones[tone],
		href && 'hover:border-accent-500'
	]}
>
	<slot />
</Tag>
