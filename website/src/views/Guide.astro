---
import Site from '../layouts/Site.astro';
import StaleTranslationNotice from '../components/StaleTranslationNotice.astro';
import Button from '../components/ui/Button.astro';
import Part from '../components/guide/Part.astro';
import Status from '../components/guide/Status.astro';
import Thumb from '../components/guide/Thumb.astro';
import Questions from '../components/guide/Questions.astro';
import AnswerPanel from '../components/guide/AnswerPanel.astro';
import ExpertTable from '../components/guide/ExpertTable.astro';
import { loadExport } from '../data/export.ts';
import { DEFAULT_ANSWER, cloudMark } from '../data/guide.ts';
import { guideTextsFor } from '../i18n/guide-texts.ts';
import { localizedHref } from '../i18n/locale.ts';
import { isStale, messagesFor } from '../i18n/messages.ts';
import english from '../i18n/messages/guide/en.ts';
import type { LocaleKey } from '../data/seo.ts';

/*
 * "What do you need?": the console's situation guide, on the site at /guide/ (a page of its own, not inside the docs:
 * it is where someone starts who does not yet know which docs page they need), from the same data (lib/consts/situation_guide.ts
 * through the docs export). From 1024 px the page is split: the questions on the left, compact enough that both fit
 * on the first screen, and the answer on the right, which stays in view. Two tabs; on the first, two questions and
 * the common tasks, on the second the company's requests. Every answer is in the HTML, and CSS shows the chosen one,
 * so the page works with scripts off; the script (components/guide/guide.ts) adds the address, the step controls,
 * copying, and on a phone the scroll to the answer after a choice.
 */
interface Props {
	locale: LocaleKey;
}
const { locale } = Astro.props;
const t = messagesFor('guide', english, locale);
const exported = loadExport().situationGuide;
const texts = guideTextsFor(locale, exported);
const { questions, situations } = exported;

const byId = new Map(situations.map((s) => [s.id, s]));
for (const id of [DEFAULT_ANSWER.product, DEFAULT_ANSWER.enterprise]) {
	if (!byId.has(id))
		throw new Error(`The guide's default answer "${id}" is not a situation`);
}
for (const s of situations) {
	if (s.next && !byId.has(s.next))
		throw new Error(
			`The guide's answer "${s.id}" names "${s.next}" as next, which is no situation`
		);
}
const productDefault = byId.get(DEFAULT_ANSWER.product);
const defaultActor = productDefault?.ask?.actor ?? questions[0]?.actor ?? 'person';

const chips = situations.filter((s) => s.tab === 'product' && !s.ask);
const enterprise = [
	...situations.filter((s) => s.tab === 'enterprise' && s.first),
	...situations.filter((s) => s.tab === 'enterprise' && !s.first)
];

const pricingHref = `${await localizedHref('/pricing/', locale)}#cloud`;
const ownServerHref = await localizedHref(
	'/docs/get-started/docker-compose/',
	locale
);
const firstClient = await localizedHref(
	'/docs/get-started/first-client/',
	locale
);

/*
 * Which answer CSS shows: the one whose radio is checked, on the tab whose radio is checked. Generated, because a
 * selector names an id. Question 2's list belongs to the actor chosen in question 1; when the chosen answer is
 * another actor's (only possible with scripts off), the answer is hidden and a hint asks for question 2.
 *
 * A common task is a link, not a radio. With the script, choosing one unchecks question 2 and names the task on the
 * root (`data-chip`); without it, the task's answer is the `:target` and wins until the reader leaves it, since a
 * radio cannot change the address (the hint under the tasks links back to the questions).
 *
 * The step a reader points at, or steps to with the arrows (`data-step` on the answer), picks out its arrow and its
 * line in the list; the other rows fade.
 */
const actors = questions.map((q) => q.actor);
const mostSteps = Math.max(...situations.map((s) => s.steps.length));
const stepRules = Array.from({ length: mostSteps }, (_, i) => {
	const k = i + 1;
	return (
		`.g-answer:is([data-step="${k}"],:has(.g-steps>li:nth-child(${k}):hover)) .g-row:not(:nth-child(${k})){opacity:.28}` +
		`.g-answer:is([data-step="${k}"],:has(.g-steps>li:nth-child(${k}):hover)) .g-row:nth-child(${k}) .g-label{box-shadow:0 0 0 3px var(--g-fox-ring);border-color:var(--g-fox-border)}` +
		`.g-answer[data-step="${k}"] .g-steps>li:nth-child(${k}){background:var(--g-sel-bg);box-shadow:inset 3px 0 0 var(--g-fox-border)}`
	);
});
const showRules = [
	...actors.map(
		(actor) =>
			`.guide:has(#g-actor-${actor}:checked) #g-q2-${actor}{display:block}`
	),
	...situations.map((s) =>
		s.tab === 'enterprise'
			? `.guide:has(#g-tab-enterprise:checked):has(#g-e-${s.id}:checked) #answer-${s.id}{display:block}`
			: s.ask
				? `.guide:has(#g-tab-product:checked):has(#g-s-${s.id}:checked) #answer-${s.id}{display:block}`
				: `.guide[data-chip=${s.id}]:has(#g-tab-product:checked) #answer-${s.id}{display:block}` +
					`.guide:not([data-ready]):has(#answer-${s.id}:target) .g-chip[data-chip=${s.id}]{border-color:var(--g-sel-border);background:var(--g-sel-bg);box-shadow:inset 0 0 0 1px var(--g-sel-border)}`
	),
	...actors.flatMap((actor) =>
		actors
			.filter((other) => other !== actor)
			.map(
				(other) =>
					`.guide:has(#g-tab-product:checked):has(#g-actor-${actor}:checked):has(.g-ans-${other}:checked) .g-answer[data-tab=product]:not(:target){display:none!important}` +
					`.guide:has(#g-tab-product:checked):has(#g-actor-${actor}:checked):has(.g-ans-${other}:checked) .g-pick{display:block}`
			)
	),
	...stepRules
].join('\n');
---

<Site
	title={`${t.title} | FoxAuth`}
	description={t.description}
	locale={locale}
>
	<div class="mx-auto max-w-6xl px-4 pb-16 pt-6 sm:px-6 lg:pt-8">
		<div class="guide" data-guide>
			<div class="g-layout">
				<div class="g-left">
					<h1 class="g-h1">{t.title}</h1>
					<p class="g-lead">{t.lead}</p>
					{
						(isStale('guide', locale) ||
							isStale('guideSituations', locale)) && (
							<StaleTranslationNotice
								locale={locale}
								english="/guide/"
								class="mt-3"
							/>
						)
					}

					<fieldset class="mt-4 min-w-0 border-0 p-0">
						<legend class="sr-only">{t.tabs.legend}</legend>
						<div class="g-tabs">
							<label class="g-tab">
								<input
									type="radio"
									name="guide-tab"
									id="g-tab-product"
									value="product"
									checked
									class="g-radio"
								/>
								<Part part="person" />
								<span class="min-w-0">
									<span class="g-tab-t">{t.tabs.product}</span>
									<span class="g-tab-s">{t.tabs.productSub}</span>
								</span>
							</label>
							<label class="g-tab">
								<input
									type="radio"
									name="guide-tab"
									id="g-tab-enterprise"
									value="enterprise"
									class="g-radio"
								/>
								<Part part="company" />
								<span class="min-w-0">
									<span class="g-tab-t">{t.tabs.enterprise}</span>
									<span class="g-tab-s">{t.tabs.enterpriseSub}</span>
								</span>
							</label>
						</div>
					</fieldset>

					<div class="g-panel mt-5" id="g-panel-product">
						<Questions
							questions={questions}
							chips={chips}
							situations={byId}
							texts={texts}
							t={t}
							actor={defaultActor}
							chosen={DEFAULT_ANSWER.product}
						/>
					</div>

					<div class="g-panel mt-5" id="g-panel-enterprise">
						<h2
							id="enterprise"
							class="text-[1.0625rem] font-[650] leading-snug tracking-tight text-balance text-gray-950 dark:text-white"
						>
							{t.enterprise.heading}
						</h2>
						<p class="mt-1 text-[0.875rem] text-gray-700 dark:text-gray-300">
							{t.enterprise.lead}
						</p>
						<div class="g-ent-pic" aria-hidden="true">
							<div class="g-ent-zone">
								<span class="g-ent-zl">{t.enterprise.tag}</span>
								<div class="g-ent-row">
									<span class="g-mini">
										<span class="g-mini-t">
											<Part part="team" />
										</span>
										{t.enterprise.picture.employees}
									</span>
									<span class="g-mini">
										<span class="g-mini-t">
											<Part part="company" />
										</span>
										{t.enterprise.picture.idp}
									</span>
									<span class="g-mini">
										<span class="g-mini-t">
											<Part part="directory" />
										</span>
										{t.enterprise.picture.directory}
									</span>
								</div>
							</div>
							<span class="g-ent-arrow">&rarr;</span>
							<span class="g-mini g-mini--fox">
								<span class="g-mini-t">
									<Part part="fox" />
								</span>
								{t.enterprise.picture.yourApp}
							</span>
						</div>

						<fieldset class="mt-4 min-w-0 border-0 p-0">
							<legend class="mb-1 p-0 text-[0.9375rem] font-semibold text-gray-950 dark:text-white">
								{t.enterprise.legend}
							</legend>
							<p class="mb-2 text-[0.8125rem] text-gray-700 dark:text-gray-300">
								{t.enterprise.together}
							</p>
							<div class="g-opts g-opts--ent">
								{
									enterprise.map((s) => {
										const mark = cloudMark(s.needs);
										return (
											<label class="g-opt g-opt--ent">
												<input
													type="radio"
													name="guide-enterprise"
													id={`g-e-${s.id}`}
													value={s.id}
													checked={s.id === DEFAULT_ANSWER.enterprise}
													class="g-radio"
												/>
												<Thumb parts={s.optionParts} />
												<span class="g-opt-text">
													<span class="g-opt-t">{texts.situations[s.id]?.title}</span>
													<span class="g-opt-tags">
														{s.first && (
															<span class="g-together">{t.enterprise.togetherTag}</span>
														)}
														<Status mark={mark} label={t.status[mark]} />
													</span>
												</span>
											</label>
										);
									})
								}
							</div>
						</fieldset>
					</div>
				</div>

				<div class="g-answers" data-answers>
					<p class="g-pick">{t.questions.pickSecond}</p>
					{
						situations.map((s) => {
							const situationTexts = texts.situations[s.id];
							return situationTexts ? (
								<AnswerPanel
									situation={s}
									texts={situationTexts}
									nextTitle={
										s.next ? texts.situations[s.next]?.title : undefined
									}
									t={t}
									pricingHref={pricingHref}
									ownServerHref={ownServerHref}
									locale={locale}
								/>
							) : null;
						})
					}
				</div>
			</div>

			<div class="g-after">
				<div class="g-nf">
					<h2
						id="nothing-fits"
						class="text-base font-semibold text-gray-950 dark:text-white"
					>
						{t.nothingFits.heading}
					</h2>
					<p class="mt-1.5 text-sm text-gray-700 dark:text-gray-300">
						{t.nothingFits.body}
					</p>
					<div class="mt-4 flex flex-wrap gap-2">
						<Button href={firstClient} variant="secondary" wrap>
							{t.nothingFits.firstClient}
						</Button>
						<Button href="/docs/reference/settings/" variant="secondary" wrap>
							{t.nothingFits.settings}
						</Button>
					</div>
				</div>
				<div class="min-w-0">
					<h2
						id="all-situations"
						class="text-base font-semibold text-gray-950 dark:text-white"
					>
						{t.all.heading}
					</h2>
					<p class="mt-1 text-sm text-gray-700 dark:text-gray-300">
						{t.all.caption}
					</p>
					<details class="g-all">
						<summary>
							{t.all.summary} ({situations.length})
						</summary>
						<div class="px-4 pb-4">
							<ExpertTable situations={situations} texts={texts} t={t} />
						</div>
					</details>
				</div>
			</div>
			<style is:inline set:html={showRules}></style>
		</div>
	</div>
</Site>

<style is:global>
	/* The guide's colours: every picture, frame and option reads these, so the dark scheme is one block. */
	.guide {
		--g-surface: #fff;
		--g-border: var(--color-gray-200);
		--g-border-strong: var(--color-gray-300);
		--g-muted: var(--color-gray-50);
		--g-muted-strong: var(--color-gray-100);
		--g-text: var(--color-gray-900);
		--g-text-strong: var(--color-gray-950);
		--g-text-2: var(--color-gray-700);
		--g-text-3: var(--color-gray-600);
		--g-link: var(--color-accent-800);
		--g-ink: var(--color-gray-800);
		--g-tile: #fff;
		--g-tile-border: var(--color-gray-300);
		--g-fox-bg: var(--color-accent-50);
		--g-fox-border: var(--color-accent-500);
		--g-fox-icon: var(--color-accent-700);
		--g-fox-ink: var(--color-accent-800);
		--g-fox-ring: rgb(240 90 35 / 0.14);
		--g-fox-lane: rgb(240 90 35 / 0.06);
		--g-outside: var(--color-gray-500);
		--g-life: var(--color-gray-200);
		--g-arrow: var(--color-gray-600);
		--g-token: var(--color-accent-700);
		--g-token-ink: var(--color-accent-800);
		--g-deny: #dc2626;
		--g-deny-ink: #b91c1c;
		--g-on-deny: #fff;
		--g-good: #15803d;
		--g-on-good: #fff;
		--g-num-bg: var(--color-gray-900);
		--g-num-text: var(--color-gray-50);
		--g-num-on: #fff;
		--g-sel-bg: var(--color-accent-50);
		--g-sel-border: var(--color-accent-500);
		--g-chip-bg: var(--color-gray-100);
		--g-ready-bg: var(--color-accent-100);
		--g-ready-ink: var(--color-accent-900);
		--g-ready-dot: var(--color-accent-700);
		--g-ready-dot-ink: #fff;
		--g-ms-bg: #fff;
		--g-ms-border: var(--color-gray-300);
		--g-problem-bg: var(--color-gray-50);
		--g-fix-bg: var(--color-accent-50);
		--g-fix-border: var(--color-accent-200);
		--g-get-bg: #fff;
		--g-tabs-bg: var(--color-gray-100);
	}
	/* A marketing page: no theme attribute is ever stamped, so the reader's system setting decides. */
	@media (prefers-color-scheme: dark) {
		.guide {
			--g-surface: var(--color-gray-900);
			--g-border: var(--color-gray-700);
			--g-border-strong: var(--color-gray-600);
			--g-muted: var(--color-gray-800);
			--g-muted-strong: var(--color-gray-700);
			--g-text: var(--color-gray-100);
			--g-text-strong: #fff;
			--g-text-2: var(--color-gray-300);
			--g-text-3: var(--color-gray-400);
			--g-link: var(--color-accent-200);
			--g-ink: var(--color-gray-100);
			--g-tile: var(--color-gray-800);
			--g-tile-border: var(--color-gray-600);
			--g-fox-bg: #3a2114;
			--g-fox-border: var(--color-accent-400);
			--g-fox-icon: var(--color-accent-300);
			--g-fox-ink: var(--color-accent-200);
			--g-fox-ring: rgb(249 126 58 / 0.2);
			--g-fox-lane: rgb(249 126 58 / 0.08);
			--g-outside: var(--color-gray-400);
			--g-life: var(--color-gray-700);
			--g-arrow: var(--color-gray-400);
			--g-token: var(--color-accent-300);
			--g-token-ink: var(--color-accent-200);
			--g-deny: #f87171;
			--g-deny-ink: #fca5a5;
			--g-on-deny: var(--color-gray-950);
			--g-good: #4ade80;
			--g-on-good: var(--color-gray-950);
			--g-num-bg: var(--color-gray-100);
			--g-num-text: var(--color-gray-900);
			--g-num-on: var(--color-gray-950);
			--g-sel-bg: rgb(249 126 58 / 0.12);
			--g-sel-border: var(--color-accent-400);
			--g-chip-bg: var(--color-gray-800);
			--g-ready-bg: rgb(249 126 58 / 0.16);
			--g-ready-ink: var(--color-accent-200);
			--g-ready-dot: var(--color-accent-300);
			--g-ready-dot-ink: var(--color-gray-950);
			--g-ms-bg: var(--color-gray-950);
			--g-ms-border: var(--color-gray-700);
			--g-problem-bg: var(--color-gray-950);
			--g-fix-bg: #241812;
			--g-fix-border: var(--color-accent-900);
			--g-get-bg: var(--color-gray-950);
			--g-tabs-bg: var(--color-gray-900);
		}
	}

	/* What shows: the chosen tab's panel, question 2 of the chosen actor and the chosen answer (rules below the page). */
	.guide .g-panel,
	.guide .g-q2,
	.guide .g-answer,
	.guide .g-pick,
	.guide .g-target-hint {
		display: none;
	}
	.guide:has(#g-tab-product:checked) #g-panel-product,
	.guide:has(#g-tab-enterprise:checked) #g-panel-enterprise {
		display: block;
	}
	/* With scripts off, an `#answer-<id>` link (a task, the table, "Next") shows that answer whatever the radios say. */
	.guide:not([data-ready]) .g-answer:target {
		display: block !important;
	}
	.guide:not([data-ready]):has(.g-answer:target) .g-answer:not(:target),
	.guide:not([data-ready]):has(.g-answer:target) .g-pick {
		display: none !important;
	}
	.guide:not([data-ready]):has(.g-answer[data-tab='product']:target) .g-target-hint {
		display: block;
	}
	.guide:not([data-ready]) .g-needs-js {
		display: none !important;
	}
	/* A browser without :has() shows every panel and every answer, one after another, rather than none. */
	@supports not selector(:has(*)) {
		.guide .g-panel,
		.guide .g-q2,
		.guide .g-answer {
			display: block;
		}
		.guide .g-answer {
			margin-top: 1.5rem;
		}
	}

	/* The split: questions left, the answer right and in view. */
	.g-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.5rem;
	}
	@media (min-width: 1024px) {
		.g-layout {
			grid-template-columns: 22.5rem minmax(0, 1fr);
			align-items: start;
			column-gap: 2rem;
		}
		.g-answers {
			position: sticky;
			top: var(--g-sticky-top, 4.75rem);
		}
	}
	.g-left,
	.g-answers {
		min-width: 0;
	}
	.g-h1 {
		font-size: 1.75rem;
		font-weight: 650;
		line-height: 1.12;
		letter-spacing: -0.03em;
		text-wrap: balance;
		color: var(--g-text-strong);
	}
	.g-lead {
		margin-top: 0.375rem;
		font-size: 0.9375rem;
		line-height: 1.45;
		color: var(--g-text-2);
	}
	@media (min-width: 1024px) {
		.g-h1 {
			font-size: 2.25rem;
		}
		.g-lead {
			font-size: 1rem;
		}
	}
	.g-pick {
		padding: 1rem;
		border: 1px dashed var(--g-border-strong);
		border-radius: var(--radius-card);
		color: var(--g-text-2);
	}

	/* A radio is drawn by its label: the input stays focusable and clickable over the whole option. */
	.g-radio {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		opacity: 0;
		cursor: pointer;
	}

	/* The tabs, as one segmented control. */
	.g-tabs {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 4px;
		padding: 4px;
		border-radius: calc(var(--radius-control) + 4px);
		background: var(--g-tabs-bg);
	}
	@media (prefers-color-scheme: dark) {
		.g-tabs {
			border: 1px solid var(--color-gray-800);
		}
	}
	.g-tab {
		position: relative;
		display: flex;
		min-width: 0;
		align-items: center;
		gap: 0.5rem;
		padding: 0.45rem 0.6rem;
		border-radius: var(--radius-control);
		color: var(--g-text-2);
		cursor: pointer;
	}
	.g-tab > .g-glyph {
		flex: none;
		width: 1.25rem;
		height: 1.25rem;
	}
	.g-tab-t {
		display: block;
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.25;
		color: var(--g-text);
	}
	.g-tab-s {
		display: block;
		font-size: 0.75rem;
		line-height: 1.3;
		color: var(--g-text-3);
	}
	.g-tab:hover {
		background: rgb(255 255 255 / 0.5);
	}
	.g-tab:has(:checked) {
		background: var(--g-surface);
		box-shadow:
			0 1px 2px rgb(31 28 25 / 0.1),
			0 0 0 1px var(--g-border);
		color: var(--g-fox-icon);
	}
	.g-tab:has(:focus-visible),
	.g-opt:has(:focus-visible) {
		outline: 2px solid var(--color-accent-500);
		outline-offset: 2px;
	}
	@media (prefers-color-scheme: dark) {
		.g-tab:hover {
			background: rgb(255 255 255 / 0.04);
		}
		.g-tab:has(:checked) {
