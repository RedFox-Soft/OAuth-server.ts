---
/*
 * Starlight builds its own <head>, so the documentation pages never pass through Seo.astro. Left
 * alone they shipped with no social card, no structured data, no last-modified signal and no link
 * to their Markdown alternate — a third of the site missing what the rest carries.
 *
 * This override renders Starlight's head unchanged and adds only what it omits, so canonical, title
 * and description stay Starlight's business and there is no second component competing to set them.
 */
import Default from '@astrojs/starlight/components/Head.astro';
import { cardSlug, isDocsFallback, normaliseRoute, stripLocale } from '../data/seo.ts';
import { breadcrumbList, crumbsFor, techArticle, type JsonLd } from '../data/structured.ts';
import { languageScriptSource } from '../i18n/language-script.ts';
import { lastModified } from '../../scripts/seo/lastmod.ts';
import { sourcesFor } from '../../scripts/seo/sources.ts';

const { entry } = Astro.locals.starlightRoute;
const route = normaliseRoute(Astro.url.pathname);
// A fallback repeats the English page, so everything here describes that page (src/route-middleware.ts).
const fallback = isDocsFallback(route);
const source = fallback ? stripLocale(route) : route;
const canonical = new URL(source, Astro.site).href;

const ogImage = new URL(`/og/${cardSlug(route)}.png`, Astro.site).href;

const { sourceFile, dataSources } = sourcesFor(route);
const lastmod = lastModified(sourceFile, dataSources);

const title = entry.data.title;
const description = entry.data.description ?? '';

const blocks: JsonLd[] = [
	techArticle({
		headline: title,
		description,
		canonical,
		dateModified: lastmod,
		inLanguage: fallback ? 'en' : Astro.locals.starlightRoute.lang
	})
];
const crumbs = crumbsFor(route, title);
if (crumbs.length > 1) blocks.push(breadcrumbList(crumbs));
---

<Default><slot /></Default>

<meta
	property="og:image"
	content={ogImage}
/>
<meta
	name="twitter:image"
	content={ogImage}
/>
{
	lastmod && (
		<meta
			name="last-modified"
			content={lastmod}
		/>
	)
}
<link
	rel="alternate"
	type="text/markdown"
	href={`${source.replace(/\/$/, '')}.md`}
/>
{
	blocks.map((block) => (
		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify(block)}
		/>
	))
}
{/* The language script, last as in Seo.astro: it reads the hreflang links above. */}
<script
	is:inline
	set:html={languageScriptSource()}
/>
