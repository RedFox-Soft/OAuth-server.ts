---
import Status from './Status.astro';
import english from '../../i18n/messages/guide/en.ts';
import type { GuideSituationEntry } from '../../data/export.ts';
import type { GuideTexts } from '../../i18n/guide-texts.ts';
import { cloudMark } from '../../data/guide.ts';

/*
 * Every situation in one table, for a reader who already knows the protocol they want, grouped by the tab it is on.
 * Each title links to its answer by `#answer-<id>`, which shows it with scripts off too. Each row carries the same
 * status mark as its answer and its option. On a phone a row stacks: the title and the mark, the protocol under them.
 */
interface Props {
	situations: GuideSituationEntry[];
	texts: GuideTexts;
	t: typeof english;
}
const { situations, texts, t } = Astro.props;
const groups = [
	{ label: t.all.product, rows: situations.filter((s) => s.tab === 'product') },
	{
		label: t.all.enterprise,
		rows: situations.filter((s) => s.tab === 'enterprise')
	}
];
---

<table class="g-table">
	<colgroup>
		<col class="w-[42%]" />
		<col class="w-[36%]" />
		<col class="w-[22%]" />
	</colgroup>
	<thead>
		<tr>
			<th scope="col">{t.all.situation}</th>
			<th scope="col">{t.all.protocol}</th>
			<th scope="col">{t.all.mark}</th>
		</tr>
	</thead>
	{
		groups.map((group) => (
			<tbody>
				<tr class="g-table-group">
					<th scope="colgroup" colspan="3">
						{group.label}
					</th>
				</tr>
				{group.rows.map((s) => {
					const mark = cloudMark(s.needs);
					return (
						<tr>
							<td class="g-table-title">
								<a href={`#answer-${s.id}`}>{texts.situations[s.id]?.title}</a>
							</td>
							<td class="g-table-proto">
								{texts.situations[s.id]?.protocol ?? s.protocol}
							</td>
							<td class="g-table-mark">
								<Status mark={mark} label={t.status[mark]} size="md" />
							</td>
						</tr>
					);
				})}
			</tbody>
		))
	}
</table>

<style is:global>
	.g-table {
		width: 100%;
		margin-top: 0.75rem;
		table-layout: fixed;
		border-collapse: collapse;
		font-size: 0.875rem;
		text-align: start;
	}
	.g-table thead th {
		padding: 0.5rem 0.75rem 0.5rem 0;
		border-bottom: 1px solid var(--g-border-strong);
		font-size: 0.75rem;
		font-weight: 600;
		text-align: start;
		color: var(--g-text-3);
	}
	.g-table td {
		padding: 0.5rem 0.75rem 0.5rem 0;
		border-bottom: 1px solid var(--g-border);
		vertical-align: top;
		color: var(--g-text-2);
		overflow-wrap: break-word;
	}
	.g-table-title a {
		font-weight: 500;
		color: var(--g-link);
		text-underline-offset: 2px;
	}
	.g-table-title a:hover {
		text-decoration: underline;
	}
	.g-table-group th {
		padding: 1rem 0 0.375rem;
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-align: start;
		text-transform: uppercase;
		color: var(--g-fox-ink);
	}
	@media (max-width: 639px) {
		.g-table colgroup,
		.g-table thead {
			display: none;
		}
		.g-table,
		.g-table tbody {
			display: block;
		}
		.g-table tr {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 0.125rem 0.75rem;
			padding: 0.5rem 0;
			border-bottom: 1px solid var(--g-border);
		}
		.g-table tr.g-table-group {
			display: block;
			border: 0;
			padding: 0;
		}
		.g-table-group th {
			display: block;
		}
		.g-table td {
			padding: 0;
			border: 0;
		}
		.g-table-proto {
			grid-column: 1 / -1;
			grid-row: 2;
			font-size: 0.75rem;
		}
	}
</style>
