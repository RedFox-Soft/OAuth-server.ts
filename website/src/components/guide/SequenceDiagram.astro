---
import Part from './Part.astro';
import Words from './Words.astro';
import english from '../../i18n/messages/guide/en.ts';
import type { GuideSituationEntry } from '../../data/export.ts';

/*
 * One diagram for every answer: the lanes across the top, each headed by its part and its name, one row per step,
 * each step an arrow from lane to lane. Plain HTML and CSS, so it renders with scripts off and every colour comes from
 * a custom property set on `.guide`. The lanes are columns of one grid (`minmax(0,1fr)` each), so a long label wraps
 * instead of widening the page. FoxAuth's lane is tinted all the way down. The rows are decoration for sighted
 * readers; the numbered list after it says the same in words, and its items take no tab stop.
 *
 * The rows draw in one after another, once, whenever the answer is shown; a reader who asks for reduced motion gets
 * them all at once. Under the diagram, a key names only the kinds of line this diagram uses.
 */
interface Props {
	lanes: GuideSituationEntry['lanes'];
	steps: GuideSituationEntry['steps'];
	laneLabels: Record<string, string>;
	stepLabels: string[];
	legend: (typeof english)['legend'];
}
const { lanes, steps, laneLabels, stepLabels, legend } = Astro.props;

const toneOf = (kind: string) =>
	kind === 'fox'
		? 'fox'
		: kind === 'outside' || kind === 'company'
			? 'outside'
			: kind === 'proxy'
				? 'proxy'
				: 'plain';
const index = new Map(lanes.map((lane, i) => [lane.id, i]));

const rows = steps.map((step, i) => {
	const a = index.get(step.from) ?? 0;
	const b = index.get(step.to) ?? 0;
	const lo = Math.min(a, b);
	const span = Math.abs(a - b) + 1;
	const direction = a < b ? 'right' : a > b ? 'left' : 'self';
	return {
		n: i + 1,
		label: stepLabels[i] ?? step.label,
		style: step.style ?? 'request',
		direction,
		column: `${lo + 1} / span ${span}`,
		span
	};
});

const used = new Set(
	rows.map((row) => (row.direction === 'self' ? 'self' : row.style))
);
const keys = [
	...(lanes.some((l) => toneOf(l.kind) === 'fox') ? ['fox'] : []),
	...(lanes.some((l) => toneOf(l.kind) === 'outside') ? ['outside'] : []),
	...(lanes.some((l) => toneOf(l.kind) === 'proxy') ? ['proxy'] : []),
	...(['request', 'redirect', 'token', 'refusal', 'self'] as const).filter(
		(key) => used.has(key)
	)
] as const;
const keyText = (key: string): string =>
	key === 'fox'
		? legend.fox
		: key === 'outside'
			? legend.outside
			: key === 'proxy'
				? legend.proxy
				: key === 'redirect'
					? legend.redirect
					: key === 'token'
						? legend.token
						: key === 'refusal'
							? legend.refusal
							: key === 'self'
								? legend.self
								: legend.request;
---

<div
	class="g-diagram"
	style={`--lanes: ${lanes.length}`}
	aria-hidden="true"
	data-diagram
>
	<div class="g-lanes">
		{
			lanes.map((lane) => (
				<div class={`g-lane g-lane--${toneOf(lane.kind)}`}>
					<Part part={lane.part} />
					<span>
						<Words text={laneLabels[lane.id] ?? lane.label} />
					</span>
				</div>
			))
		}
	</div>
	<div class="g-body">
		<div class="g-life">
			{lanes.map((lane) => <span class={`g-life--${toneOf(lane.kind)}`} />)}
		</div>
		<ol class="g-rows">
			{
				rows.map((row) => (
					<li
						class:list={['g-row', `g-${row.style}`, `g-${row.direction}`]}
						style={`--i: ${row.n - 1}`}
					>
						<div
							class="g-arrow"
							style={`grid-column: ${row.column}; --span: ${row.span}`}
						>
							<span class="g-label">
								<span class="g-num">{row.n}</span>
								<span class="g-label-text">{row.label}</span>
							</span>
							{row.direction !== 'self' && <span class="g-line" />}
						</div>
					</li>
				))
			}
		</ol>
	</div>
</div>
<ul class="g-key-list" aria-hidden="true">
	{
		keys.map((key) => (
			<li>
				<span class={`g-key g-key--${key}`} />
				{keyText(key)}
			</li>
		))
	}
</ul>

<style is:global>
	.g-diagram {
		container: diagram / inline-size;
		margin-top: 0.75rem;
	}
	.g-lanes,
	.g-row,
	.g-life {
		display: grid;
		grid-template-columns: repeat(var(--lanes), minmax(0, 1fr));
		column-gap: 0.375rem;
	}
	.g-lane {
		display: flex;
		min-width: 0;
		min-height: 2.75rem;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		padding: 0.375rem 0.375rem;
		border: 1.5px solid var(--g-tile-border);
		border-radius: var(--radius-control);
		background: var(--g-tile);
		color: var(--g-ink);
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.2;
		text-align: center;
	}
	.g-lane > .g-glyph {
		flex: none;
		width: 1.25rem;
		height: 1.25rem;
	}
	.g-lane > span {
		min-width: 0;
		overflow-wrap: break-word;
	}
	.g-lane--fox {
		border: 2px solid var(--g-fox-border);
		background: var(--g-fox-bg);
		color: var(--g-fox-ink);
	}
	.g-lane--fox > .g-glyph {
		color: var(--g-fox-icon);
	}
	.g-lane--outside {
		border-style: dashed;
		border-color: var(--g-outside);
	}
	.g-lane--outside > .g-glyph {
		color: var(--g-outside);
	}
	.g-lane--proxy {
		border: 3px double var(--g-ink);
	}

	.g-body {
		position: relative;
	}
	/* The lifelines: one line down the middle of every lane, and FoxAuth's lane tinted, behind all the rows. */
	.g-life {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.g-life > span {
		position: relative;
	}
	.g-life > span::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 50%;
		width: 2px;
		margin-left: -1px;
		background: var(--g-life);
	}
	.g-life--fox {
		border-radius: 0 0 var(--radius-control) var(--radius-control);
		background: var(--g-fox-lane);
	}
	.g-life--fox::before {
		background: var(--g-fox-border) !important;
		opacity: 0.35;
	}
	.g-rows {
		position: relative;
		margin: 0;
		padding: 0.375rem 0 0.75rem;
		list-style: none;
	}
	.g-rows > li {
		margin: 0;
		padding-block: 0.3125rem;
		transition: opacity 0.2s;
	}
	.g-arrow {
		display: flex;
		min-width: 0;
		flex-direction: column;
		align-items: center;
		gap: 0.3125rem;
		color: var(--g-arrow);
	}
	.g-token .g-arrow {
		color: var(--g-token);
	}
	.g-refusal .g-arrow {
		color: var(--g-deny);
	}
	.g-label {
		position: relative;
		z-index: 1;
		display: inline-flex;
		max-width: 100%;
		align-items: center;
		gap: 0.35rem;
		padding: 0.125rem 0.5rem 0.125rem 0.1875rem;
		border: 1px solid var(--g-border);
		border-radius: 999px;
		background: var(--g-surface);
		box-shadow: 0 1px 2px rgb(31 28 25 / 0.06);
		color: var(--g-ink);
		font-size: 0.78rem;
		font-weight: 500;
		line-height: 1.25;
		text-align: start;
	}
	.g-label-text {
		min-width: 0;
		overflow-wrap: break-word;
		hyphens: manual;
	}
	.g-token .g-label {
		border-color: var(--g-token);
		color: var(--g-token-ink);
		font-weight: 600;
	}
	.g-refusal .g-label {
		border-color: var(--g-deny);
		color: var(--g-deny-ink);
	}
	.g-num {
		display: grid;
		flex: none;
		place-items: center;
		width: 1.25rem;
		height: 1.25rem;
		border-radius: 999px;
		background: var(--g-num-bg);
		color: var(--g-num-text);
		font-size: 0.6875rem;
		font-weight: 700;
	}
	.g-token .g-num {
		background: var(--g-token);
		color: var(--g-num-on);
	}
	.g-refusal .g-num {
		background: var(--g-deny);
		color: var(--g-num-on);
	}
	.g-self .g-label {
		border-style: dashed;
		border-width: 1.5px;
	}

	/* The arrow runs from the middle of its first lane to the middle of its last: half a lane in from each edge. */
	.g-line {
		position: relative;
		align-self: stretch;
		height: 0;
		margin-inline: calc(100% / var(--span) / 2);
		border-top: 2.5px solid currentColor;
	}
	.g-redirect .g-line {
		border-top-style: dashed;
	}
	.g-token .g-line {
		border-top-width: 4.5px;
	}
	.g-refusal .g-line {
		border-top-style: dashed;
	}
	.g-line::after {
		content: '';
		position: absolute;
		top: -7.25px;
		border-block: 6px solid transparent;
	}
	.g-token .g-line::after {
		top: -8.25px;
	}
	.g-right .g-line::after {
		right: -3px;
		border-left: 10px solid currentColor;
	}
	.g-left .g-line::after {
		left: -3px;
		border-right: 10px solid currentColor;
	}

	@media (prefers-reduced-motion: no-preference) {
		.g-row {
			animation: g-step-in 0.35s ease-out both;
			animation-delay: calc(var(--i) * 0.28s + 0.1s);
		}
		.g-right .g-line,
		.g-left .g-line {
			animation: g-draw 0.35s ease-out both;
			animation-delay: calc(var(--i) * 0.28s + 0.18s);
		}
		.g-right .g-line {
			transform-origin: left;
		}
		.g-left .g-line {
			transform-origin: right;
		}
	}
	@keyframes g-step-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
	@keyframes g-draw {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	@container diagram (max-width: 30rem) {
		.g-lanes,
		.g-row,
		.g-life {
			column-gap: 0.25rem;
		}
		.g-lane {
			flex-direction: column;
			gap: 0.125rem;
			padding: 0.3rem 0.15rem;
			font-size: 0.6875rem;
		}
		.g-lane > .g-glyph {
			width: 1.125rem;
			height: 1.125rem;
		}
		.g-label {
			padding-inline-end: 0.375rem;
			font-size: 0.6875rem;
		}
		.g-num {
			width: 1.05rem;
			height: 1.05rem;
			font-size: 0.625rem;
		}
	}

	/* The key: only the kinds of line this diagram draws. */
	.g-key-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin-top: 0.25rem;
		font-size: 0.75rem;
		color: var(--g-text-3);
	}
	.g-key-list li {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.g-key {
		display: inline-block;
		width: 1.5rem;
		height: 0;
		border-top: 2.5px solid var(--g-arrow);
	}
	.g-key--redirect {
		border-top-style: dashed;
	}
	.g-key--token {
		border-top: 4.5px solid var(--g-token);
	}
	.g-key--refusal {
		border-top: 2.5px dashed var(--g-deny);
	}
	.g-key--fox,
	.g-key--outside,
	.g-key--self {
		width: 0.875rem;
		height: 0.875rem;
		border: 2px solid var(--g-fox-border);
		border-radius: 0.2rem;
		background: var(--g-fox-bg);
	}
	.g-key--outside {
		border: 1.5px dashed var(--g-outside);
		background: transparent;
	}
	.g-key--proxy {
		width: 0.875rem;
		height: 0.875rem;
		border: 3px double var(--g-ink);
		border-radius: 0.2rem;
	}
	.g-key--self {
		width: 1.25rem;
		border: 1.5px dashed var(--g-arrow);
		border-radius: 999px;
		background: transparent;
	}
</style>
