---
import Site from '../layouts/Site.astro';
import ContactForm from '../components/ContactForm.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
---

<Site
	title="Contact — FoxAuth"
	description="Reach the FoxAuth team: general enquiries at hello@foxauth.dev, vulnerability reports at security@foxauth.dev, and bugs on GitHub."
>
	<Section narrow>
		<Eyebrow>Contact</Eyebrow>
		<h1 class="text-4xl font-[650] leading-[1.15] tracking-tight text-balance">
			Three addresses, and one of them is a repository.
		</h1>
		<p class="mt-5 text-lg text-gray-600 dark:text-gray-400">
			Pick the one that matches what you have. A bug goes to the tracker, a vulnerability goes to
			the security address, and everything else comes to us.
		</p>
	</Section>

	<Section tone="muted">
		<div class="grid items-start gap-6 lg:grid-cols-3">
			<div class="lg:col-span-2">
				<Card>
					<h2 class="text-xl font-[650] tracking-tight">Talk to us</h2>
					<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
						Deployments, support contracts, consulting, or a question the docs did not answer.
					</p>
					<div class="mt-5"><ContactForm subject="FoxAuth enquiry" /></div>
				</Card>
			</div>

			<div class="flex flex-col gap-6">
				<Card>
					<h2 class="text-base font-[650] tracking-tight">Report a vulnerability</h2>
					<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
						Mail{' '}
						<a
							href="mailto:security@foxauth.dev"
							class="font-medium text-accent-700 dark:text-accent-200">security@foxauth.dev</a
						>{' '}
						— not the public tracker. The security policy sets out what we do next and how long
						it takes.
					</p>
					<p class="mt-4">
						<Button href="/security/" variant="secondary">Security policy</Button>
					</p>
				</Card>

				<Card>
					<h2 class="text-base font-[650] tracking-tight">Report a bug</h2>
					<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
						Open an issue with the version, the request and the response. Public issues get
						fixed faster because other people can confirm them.
					</p>
					<p class="mt-4">
						<Button
							href="https://github.com/RedFox-Soft/OAuth-server.ts/issues"
							variant="secondary">GitHub issues</Button
						>
					</p>
				</Card>
			</div>
		</div>
	</Section>
</Site>
