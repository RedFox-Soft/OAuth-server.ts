---
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import SequenceDiagram from './SequenceDiagram.astro';
import Status from './Status.astro';
import Strip from './Strip.astro';
import english from '../../i18n/messages/guide/en.ts';
import type { GuideSituationEntry } from '../../data/export.ts';
import type { GuideSituationTexts } from '../../i18n/guide-texts.ts';
import type { LocaleKey } from '../../data/seo.ts';
import {
	cloudMark,
	personaOf,
	renderPrompt,
	settingHref,
	settingKey
} from '../../data/guide.ts';

/*
 * One answer, complete. First the strip: the problem, the fix and what the person gets, with the one button. Then
 * what usually comes next, the sentence that says it in words, what a self-hosted server switches on, the diagram
 * with its steps in words, the limits, the prompt for a coding agent and, last, the protocol. Every answer is in the
 * page; the questions decide which one is shown.
 */
interface Props {
	situation: GuideSituationEntry;
	texts: GuideSituationTexts;
	/* The title of the answer that usually comes next, when there is one. */
	nextTitle?: string;
	t: typeof english;
	pricingHref: string;
	ownServerHref: string;
	locale: LocaleKey;
}
const {
	situation: s,
	texts,
	nextTitle,
	t,
	pricingHref,
	ownServerHref,
	locale
} = Astro.props;
const a = t.answer;
const id = s.id;
const mark = cloudMark(s.needs);
const persona = personaOf(s);
const flags = s.needs.flags ?? [];
const anyOf = s.needs.anyOf ?? [];
/*
 * What a self-hosted instance switches on: every one of `flags` (joined with "and"), and one of `anyOf` (joined with
 * "or"), each its own sentence so the two are never read as one list.
 */
const own = mark === 'ownServer';
const switches = [
	...(flags.length > 0
		? [
				{
					lead: own ? a.switchFlags : a.selfHostedFlags,
					keys: flags,
					joiner: a.and
				}
			]
		: []),
	...(anyOf.length > 0
		? [
				{
					lead:
						flags.length > 0
							? a.alsoAnyOf
							: own
								? a.switchAnyOf
								: a.selfHostedAnyOf,
					keys: anyOf,
					joiner: a.or
				}
			]
		: [])
];
const settingLink =
	'font-mono text-[0.8125rem] font-medium text-accent-800 underline-offset-2 [overflow-wrap:anywhere] hover:underline dark:text-accent-200';
const ctrl =
	'g-ctrl inline-flex h-8 min-w-8 cursor-pointer items-center justify-center gap-1.5 rounded-control border border-gray-200 bg-transparent px-2 text-sm font-medium text-gray-800 hover:border-gray-300 hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 dark:border-gray-700 dark:text-gray-100 dark:hover:bg-gray-800';
---

<article
	id={`answer-${id}`}
	class="g-answer scroll-mt-20"
	data-tab={s.tab}
	data-id={id}
	aria-labelledby={`answer-${id}-title`}
>
	<div class="g-card">
		<div class="flex flex-wrap items-center gap-2">
			<Badge>{a.persona[persona]}</Badge>
			<Status mark={mark} label={a.marks[mark]} size="md" />
		</div>
		<h2
			id={`answer-${id}-title`}
			class="mt-2 text-lg font-[650] leading-tight tracking-tight text-balance text-gray-950 sm:text-2xl dark:text-white"
		>
			{texts.title}
		</h2>

		<Strip
			situation={s}
			texts={texts}
			t={t}
			pricingHref={pricingHref}
			ownServerHref={ownServerHref}
			locale={locale}
		/>

		{
			s.next && nextTitle && (
				<a href={`#answer-${s.next}`} class="g-next">
					<span class="g-next-k">{a.next}</span>
					<span class="g-next-t">{nextTitle}</span>
					<span aria-hidden="true" class="g-next-arrow">
						&rarr;
					</span>
				</a>
			)
		}

		<p class="mt-4 text-[0.96875rem] leading-relaxed text-gray-700 dark:text-gray-300">
			{texts.sentence}
		</p>
		<div class="mt-2 flex flex-col gap-1 text-sm text-gray-700 dark:text-gray-300">
			{mark !== 'ownServer' && switches.length === 0 && <p>{a.selfHostedNone}</p>}
			{
				switches.map((line) => (
					<p>
						{line.lead}
						{line.keys.map((flag, i) => (
							<>
								{i > 0 && ` ${line.joiner}`}{' '}
								<a class={settingLink} href={settingHref(flag)}>
									{settingKey(flag)}
								</a>
							</>
						))}
					</p>
				))
			}
		</div>

		<section class="g-sec" aria-labelledby={`answer-${id}-steps`}>
			<div class="flex flex-wrap items-center justify-between gap-2">
				<h3
					id={`answer-${id}-steps`}
					class="text-base font-semibold text-gray-950 dark:text-white"
				>
					{a.steps}
				</h3>
				<div class="g-needs-js flex items-center gap-1">
					<button
						type="button"
						data-step-prev
						aria-label={a.prevStep}
						title={a.prevStep}
						class={ctrl}
					>
						<span aria-hidden="true">&larr;</span>
					</button>
					<button
						type="button"
						data-step-next
						aria-label={a.nextStep}
						title={a.nextStep}
						class={ctrl}
					>
						<span aria-hidden="true">&rarr;</span>
					</button>
					<button type="button" data-replay class={ctrl}>
						<span aria-hidden="true">&#8635;</span>
						{a.replay}
					</button>
				</div>
			</div>
			<SequenceDiagram
				lanes={s.lanes}
				steps={s.steps}
				laneLabels={texts.lanes}
				stepLabels={texts.steps.map((step) => step.label)}
				legend={t.legend}
			/>
			<ol class="g-steps">
				{
					texts.steps.map((step, i) => (
						<li>
							<span class="g-steps-n">{i + 1}</span>
							<span>{step.text}</span>
						</li>
					))
				}
			</ol>
		</section>

		{
			texts.goodToKnow.length > 0 && (
				<section class="g-sec" aria-labelledby={`answer-${id}-good`}>
					<h3
						id={`answer-${id}-good`}
						class="text-base font-semibold text-gray-950 dark:text-white"
					>
						{a.goodToKnow}
					</h3>
					<ul class="g-good">
						{texts.goodToKnow.map((line) => (
							<li>{line}</li>
						))}
					</ul>
				</section>
			)
		}

		<details class="g-prompt mt-6 rounded-control border border-gray-200 dark:border-gray-700">
			<summary class="cursor-pointer rounded-control px-4 py-2.5 text-sm font-semibold text-gray-900 focus-visible:outline-2 focus-visible:outline-accent-500 dark:text-gray-100">
				{a.prompt}
			</summary>
			<div class="border-t border-gray-200 px-4 pb-4 pt-3 dark:border-gray-700">
				<p class="text-sm text-gray-700 dark:text-gray-300">{a.promptNote}</p>
				<pre
					data-prompt
					class="mt-3 max-h-72 overflow-auto whitespace-pre-wrap rounded bg-gray-100 p-3 font-mono text-xs leading-relaxed text-gray-900 [overflow-wrap:anywhere] dark:bg-gray-950 dark:text-gray-100">{renderPrompt(s.prompt)}</pre>
				<div class="g-needs-js mt-3 flex flex-wrap items-center gap-3">
					<Button type="button" variant="secondary" wrap>
						<span data-copy data-copied={a.copied}>{a.copy}</span>
					</Button>
					<span data-copy-failed hidden class="text-sm text-gray-700 dark:text-gray-300"
						>{a.copyFailed}</span
					>
				</div>
			</div>
		</details>

		<p class="mt-4 text-xs text-gray-600 dark:text-gray-400">
			{`${a.underTheHood} ${texts.protocol ?? s.protocol}`}
		</p>
	</div>
</article>

<style is:global>
	.g-card {
		container: answer / inline-size;
		padding: 1.25rem 1.5rem 1.5rem;
		border: 1px solid var(--g-border);
		border-radius: var(--radius-frame);
		background: var(--g-surface);
		box-shadow: 0 1px 2px rgb(31 28 25 / 0.04);
	}
	@media (max-width: 639px) {
		.g-card {
			padding: 1rem;
		}
	}
	.g-next {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.75rem;
		padding: 0.625rem 0.875rem;
		border: 1px solid var(--g-fix-border);
		border-radius: var(--radius-control);
		background: var(--g-fix-bg);
		color: var(--g-text);
		font-size: 0.875rem;
		text-decoration: none;
	}
	.g-next:hover {
		border-color: var(--g-fox-border);
	}
	.g-next:focus-visible {
		outline: 2px solid var(--color-accent-500);
		outline-offset: 2px;
	}
	.g-next-k {
		flex: none;
		font-weight: 600;
		color: var(--g-fox-ink);
	}
	.g-next-t {
		min-width: 0;
		font-weight: 600;
	}
	.g-next-arrow {
		margin-inline-start: auto;
		color: var(--g-fox-ink);
		font-weight: 700;
	}
	.g-sec {
		margin-top: 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--g-border);
	}
	.g-steps {
		display: grid;
		gap: 0.25rem;
		margin-top: 0.75rem;
		font-size: 0.875rem;
		line-height: 1.45;
		color: var(--g-text);
	}
	.g-steps > li {
		display: grid;
		grid-template-columns: 1.5rem minmax(0, 1fr);
		gap: 0.375rem;
		padding: 0.25rem 0.375rem;
		border-radius: var(--radius-control);
		transition: background-color 0.2s;
	}
	.g-steps > li:hover {
		background: var(--g-muted);
	}
	.g-steps-n {
		display: grid;
		place-items: center;
		width: 1.25rem;
		height: 1.25rem;
		margin-top: 0.0625rem;
		border-radius: 999px;
		background: var(--g-muted-strong);
		color: var(--g-text);
		font-size: 0.6875rem;
		font-weight: 700;
	}
	.g-good {
		display: grid;
		gap: 0.375rem;
		margin-top: 0.625rem;
		padding-inline-start: 1.125rem;
		list-style: disc;
		font-size: 0.875rem;
		line-height: 1.45;
		color: var(--g-text);
	}
	.g-good li::marker {
		color: var(--g-fox-border);
	}
</style>
