---
import { getEntry, render } from 'astro:content';
import Site from '../layouts/Site.astro';
import { loadVersion } from '../data/version';

const entry = await getEntry('root', 'changelog');
if (!entry) throw new Error('CHANGELOG.md not found at the repository root');
const { Content } = await render(entry);
const v = loadVersion();
---

<Site
	title="Changelog — every release of OAuth-server.ts"
	description="Every notable change to OAuth-server.ts, release by release: new grants and protocol support, breaking changes, security fixes and the version each landed in."
>
	<article class="prose mx-auto max-w-3xl px-4 py-12 dark:prose-invert">
		<p class="text-sm text-gray-500 dark:text-gray-400">
			Site built from {v.unreleased ? `unreleased commit ${v.commit}` : v.lastTag}. Releases: <a
				href="https://github.com/RedFox-Soft/OAuth-server.ts/releases">GitHub</a
			>.
		</p>
		<Content />
	</article>
</Site>
