---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Site from '../../layouts/Site.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import CompareTable from '../../components/CompareTable.astro';
import FaqSection from '../../components/FaqSection.astro';
import { SITE_ORIGIN } from '../../data/seo.ts';
import { faqPage, techArticle } from '../../data/structured.ts';
import { ageInDays, isStale } from '../../../scripts/seo/freshness.ts';

export const getStaticPaths: GetStaticPaths = async () => {
	const entries = await getCollection('compare');
	return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

interface Props {
	entry: CollectionEntry<'compare'>;
}
const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const {
	title,
	competitor,
	description,
	lastChecked,
	sources,
	bottomLine,
	faq,
	chooseThem,
	chooseUs,
	groups
} = entry.data;

/*
 * The comparison pages are articles making dated, sourced claims about another product, so
 * they carry the same TechArticle the documentation does — `headline` is the visible h1,
 * because the guardrail checks every claimed string against the rendered text.
 */
const jsonLd = [
	techArticle({
		headline: title,
		description,
		canonical: new URL(`/compare/${entry.id}/`, SITE_ORIGIN).href,
		dateModified: lastChecked
	})
];
/*
 * Built from the very array FaqSection renders below, so the two cannot disagree — and the
 * guardrail's overclaim rule proves it, because every answer here must appear in the rendered text.
 */
if (faq && faq.length > 0) jsonLd.push(faqPage(faq));

/*
 * Past the freshness limit the page says so, to the reader, in place of the usual line. The
 * build also warns, but build logs are read by nobody — a notice on a page being used to win
 * comparisons is the version of this signal that actually gets acted on, and in the meantime
 * the reader is told the truth about how old the claims are.
 */
const staleDays = ageInDays(lastChecked);
const stale = isStale(lastChecked);
---

<Site
	title={`${title} — FoxAuth`}
	description={description}
	jsonLd={jsonLd}
	breadcrumbLeaf={title}
>
	<Section narrow>
		<Eyebrow>Compare</Eyebrow>
		<h1 class="text-4xl font-[650] leading-[1.15] tracking-tight text-balance">{title}</h1>
		<p class="mt-5 text-lg text-gray-600 dark:text-gray-400">{description}</p>
		<p
			class:list={[
				'mt-6 rounded-card border p-4 text-sm',
				stale
					? 'border-accent-300 bg-accent-50 text-gray-700 dark:border-accent-700 dark:bg-accent-950 dark:text-gray-200'
					: 'border-gray-200 bg-gray-50 text-gray-600 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400'
			]}
		>
			{
				stale ? (
					<Fragment>
						<strong>Due for review.</strong> Last checked {lastChecked} — {staleDays} days ago.
						Claims about {competitor} may have gone out of date since.{' '}
					</Fragment>
				) : (
					<Fragment>Last checked {lastChecked} against the linked sources. </Fragment>
				)
			}
			{competitor} changes; where its documentation did not say, this page says so rather than
			guessing. Found something out of date? Tell us at{' '}
			<a
				href="mailto:hello@foxauth.dev?subject=Comparison%20correction"
				class="font-medium text-accent-700 dark:text-accent-200">hello@foxauth.dev</a
			>.
		</p>
	</Section>

	<Section tone="muted">
		<Eyebrow>The short answer</Eyebrow>
		<p class="max-w-3xl text-xl leading-snug font-[650] tracking-tight text-balance">
			{bottomLine}
		</p>
		<div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
			<Card>
				<h2 class="text-lg font-[650] tracking-tight">Choose {competitor} if…</h2>
				<ul class="mt-3 flex flex-col gap-2 text-sm text-gray-700 dark:text-gray-300">
					{
						chooseThem.map((item) => (
							<li class="flex gap-2">
								<span class="text-gray-400 dark:text-gray-500" aria-hidden="true">
									→
								</span>
								<span>{item}</span>
							</li>
						))
					}
				</ul>
			</Card>
			<Card tone="accent">
				<h2 class="text-lg font-[650] tracking-tight">Choose FoxAuth if…</h2>
				<ul class="mt-3 flex flex-col gap-2 text-sm text-gray-700 dark:text-gray-300">
					{
						chooseUs.map((item) => (
							<li class="flex gap-2">
								<span class="text-accent-700 dark:text-accent-200" aria-hidden="true">
									→
								</span>
								<span>{item}</span>
							</li>
						))
					}
				</ul>
			</Card>
		</div>
	</Section>

	<Section>
		<Eyebrow>Side by side</Eyebrow>
		<h2 class="mb-6 text-2xl font-[650] tracking-tight">
			Every row has a verdict and the reason for it
		</h2>
		<CompareTable competitor={competitor} groups={groups} />
	</Section>

	<Section narrow tone="muted">
		<div class="prose max-w-none dark:prose-invert">
			<Content />
		</div>
	</Section>

	{
		faq && faq.length > 0 && (
			<Section narrow>
				<Eyebrow>Questions</Eyebrow>
				<h2 class="text-3xl font-[650] tracking-tight text-balance">
					What people ask before they switch
				</h2>
				<FaqSection items={faq} class="mt-8" />
			</Section>
		)
	}

	<Section narrow>
		<Eyebrow>Sources</Eyebrow>
		<h2 class="text-2xl font-[650] tracking-tight">What we read</h2>
		<ul class="mt-4 flex flex-col gap-2">
			{
				sources.map((source) => (
					<li>
						<a
							href={source}
							class="break-all text-sm text-accent-700 dark:text-accent-200"
							rel="nofollow noopener"
						>
							{source}
						</a>
					</li>
				))
			}
		</ul>
		<div class="mt-8 flex flex-wrap gap-3">
			<Button href="/docs/get-started/docker-compose/">Try it yourself</Button>
			<Button href="/features/" variant="secondary">All features</Button>
		</div>
	</Section>
</Site>
