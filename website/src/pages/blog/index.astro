---
import Site from '../../layouts/Site.astro';
import Card from '../../components/ui/Card.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Button from '../../components/ui/Button.astro';
import { publishedPosts } from '../../data/blog.ts';

/*
 * The article list, and the only path from the home page to an article — which is what keeps every
 * article inside the three-link reachability limit the guardrail enforces. Once there are enough
 * articles that this page needs paginating, that limit is the reason it is a correctness question
 * and not only an ergonomic one.
 */
const posts = await publishedPosts();

const heading = 'OAuth in practice';
---

<Site
	title={`${heading} — FoxAuth`}
	description="Notes on OAuth 2.1, OpenID Connect and running your own authorization server, written by the team building FoxAuth as we hit things worth writing down."
	breadcrumbLeaf={heading}
>
	<Section narrow>
		<Eyebrow>Blog</Eyebrow>
		<h1 class="text-4xl font-[650] leading-[1.15] tracking-tight text-balance">{heading}</h1>
		<p class="mt-5 text-lg text-gray-600 dark:text-gray-400">
			What we learned building an authorization server, written down while it is still fresh.
			Protocol decisions, the traps that cost us a day, and the operational questions the
			reference documentation does not answer.
		</p>
		<p class="mt-4 text-sm text-gray-600 dark:text-gray-400">
			Subscribe with <a
				href="/blog/rss.xml"
				class="font-medium text-accent-700 dark:text-accent-200">the feed</a
			>, or read the <a
				href="/docs/get-started/docker-compose/"
				class="font-medium text-accent-700 dark:text-accent-200">getting started guide</a
			> if you would rather try it than read about it.
		</p>
	</Section>

	<Section narrow tone="muted">
		{
			posts.length === 0 ? (
				<Card padding="lg">
					<h2 class="text-2xl font-[650] tracking-tight">Nothing published yet</h2>
					<p class="mt-3 text-gray-600 dark:text-gray-400">
						The first article is being written. In the meantime the documentation covers how
						to run the server, and the changelog covers what has shipped.
					</p>
					<div class="mt-6 flex flex-wrap gap-3">
						<Button href="/docs/get-started/docker-compose/">Read the docs</Button>
						<Button href="/changelog/" variant="secondary">
							See what shipped
						</Button>
					</div>
				</Card>
			) : (
				<ul class="flex flex-col gap-6">
					{posts.map((post) => (
						<li>
							<Card href={`/blog/${post.id}/`}>
								<p class="text-sm text-gray-500 dark:text-gray-400">
									<time datetime={post.data.publishedAt}>{post.data.publishedAt}</time>
									{post.data.updatedAt && (
										<Fragment> · updated {post.data.updatedAt}</Fragment>
									)}
								</p>
								<h2 class="mt-2 text-2xl font-[650] tracking-tight text-balance">
									{post.data.title}
								</h2>
								<p class="mt-3 text-gray-600 dark:text-gray-400">{post.data.description}</p>
							</Card>
						</li>
					))}
				</ul>
			)
		}
	</Section>
</Site>
