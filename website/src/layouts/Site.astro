---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	jsonLd?: Record<string, unknown>;
	noindex?: boolean;
}
const { title, description, image, jsonLd, noindex } = Astro.props;
---

<!doctype html>
<html lang="en" class="motion-safe:scroll-smooth" data-layout="site">
	<head>
		<Seo
			title={title}
			description={description}
			image={image}
			jsonLd={jsonLd}
			noindex={noindex}
		/>
	</head>
	<body class="bg-white text-gray-900 antialiased dark:bg-gray-950 dark:text-gray-100">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-control focus:bg-white focus:px-4 focus:py-2 focus:text-gray-900 focus:outline-2 focus:outline-accent-500 dark:focus:bg-gray-900 dark:focus:text-gray-100"
			>Skip to content</a
		>
		<Header />
		<main id="main"><slot /></main>
		<Footer />
	</body>
</html>
