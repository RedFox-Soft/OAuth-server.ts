---
interface Props {
	/* A link button. Omit it (and pass `type`) for a form control. */
	href?: string;
	variant?: 'primary' | 'secondary' | 'ghost';
	size?: 'md' | 'lg';
	/*
	 * Renders a <button> instead of an <a>, so the marketing forms submit with the same styling
	 * rather than a second copy of these class strings. Exactly one of `href` / `type` applies:
	 * `type` wins if both are given.
	 */
	type?: 'button' | 'submit';
	rel?: string;
	/*
	 * Lets a long label wrap onto a second line instead of overflowing: the height becomes a minimum. For buttons
	 * whose label is translated and may run a third longer than English on a phone.
	 */
	wrap?: boolean;
}
const {
	href,
	variant = 'primary',
	size = 'md',
	type,
	rel,
	wrap = false
} = Astro.props;
const asButton = type !== undefined || href === undefined;
const Tag = asButton ? 'button' : 'a';
const base =
	'inline-flex items-center justify-center gap-2 text-center rounded-control font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500';
const sizes = wrap
	? { md: 'min-h-10 max-w-full px-4 py-2 text-sm', lg: 'min-h-12 max-w-full px-6 py-2.5 text-base' }
	: { md: 'h-10 break-keep px-4 text-sm', lg: 'h-12 break-keep px-6 text-base' };
const variants = {
	primary:
		'bg-accent-500 text-gray-950 hover:bg-accent-400 active:bg-accent-600',
	secondary:
		'border border-gray-300 bg-white text-gray-900 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:hover:bg-gray-800',
	ghost:
		'text-accent-700 hover:bg-accent-50 dark:text-accent-200 dark:hover:bg-gray-800'
};
---

<Tag
	href={asButton ? undefined : href}
	rel={asButton ? undefined : rel}
	type={asButton ? (type ?? 'button') : undefined}
	class:list={[base, sizes[size], variants[variant]]}><slot /></Tag
>
