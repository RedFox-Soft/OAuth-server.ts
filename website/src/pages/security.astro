---
import { getEntry, render } from 'astro:content';
import Site from '../layouts/Site.astro';
import { loadVersion } from '../data/version';

const entry = await getEntry('root', 'security');
if (!entry) throw new Error('SECURITY.md not found at the repository root');
const { Content } = await render(entry);
const v = loadVersion();
---

<Site
	title="Security policy"
	description="How to report a vulnerability in OAuth-server.ts, and what happens next."
>
	<article class="prose mx-auto max-w-3xl px-4 py-12 dark:prose-invert">
		<p class="text-sm text-gray-500">
			Site built from {v.unreleased ? `unreleased commit ${v.commit}` : v.lastTag}. Releases: <a
				href="https://github.com/RedFox-Soft/OAuth-server.ts/releases">GitHub</a
			>.
		</p>
		<Content />
	</article>
</Site>
