---
import Site from '../layouts/Site.astro';
import ScreenshotFigure from '../components/ScreenshotFigure.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import CompareLinks from '../components/CompareLinks.astro';
import RichText from '../components/RichText.astro';
import StaleTranslationNotice from '../components/StaleTranslationNotice.astro';
import { organization, softwareApplication } from '../data/structured.ts';
import { backendChoice } from '../data/storage.ts';
import { loadExport } from '../data/export.ts';
import { localizedHref } from '../i18n/locale.ts';
import { isStale, messagesFor } from '../i18n/messages.ts';
import english, { type HomeFacts } from '../i18n/messages/home/en.ts';
import type { LocaleKey } from '../data/seo.ts';

interface Props {
	locale: LocaleKey;
}
const { locale } = Astro.props;
const t = messagesFor('home', english, locale);

/*
 * `license` is the abbreviation this page visibly shows in its badge row, not a URL: the guardrail
 * checks that every human-readable string a block claims also appears in the rendered text, so a
 * structured claim and the visible copy cannot drift apart unnoticed.
 */
const license = 'FSL-1.1-ALv2';
const jsonLd = [organization(), softwareApplication({ license })];
// Counted from the catalogue the build exports, so the number cannot drift from the tool list.
const mcpToolCount = loadExport().mcp.tools.length;
const facts: HomeFacts = { backends: backendChoice(locale), tools: mcpToolCount };

const quickstart = `curl -O https://raw.githubusercontent.com/RedFox-Soft/OAuth-server.ts/main/docker-compose.yml
docker compose up
# open http://localhost:3000/admin`;

const href = {
	getStarted: await localizedHref('/docs/get-started/docker-compose/', locale),
	features: await localizedHref('/features/', locale),
	endpoints: await localizedHref('/docs/reference/endpoints/', locale),
	protectMcp: await localizedHref('/docs/get-started/protect-your-mcp-server/', locale),
	mcpTools: await localizedHref('/docs/reference/mcp-tools/', locale),
	license: await localizedHref('/license/', locale),
	docs: await localizedHref('/docs/', locale),
	cloud: await localizedHref('/pricing/#cloud', locale)
};

const stepRoutes = [
	'/docs/get-started/docker-compose/',
	'/docs/get-started/first-client/',
	'/docs/get-started/first-token/'
];
const steps = await Promise.all(
	t.quickStart.steps.map(async (step, i) => ({
		...step,
		n: String(i + 1),
		// The loader refuses a translation whose step list differs in length from English, so every
		// step has a route.
		href: await localizedHref(stepRoutes[i]!, locale)
	}))
);

/* The README's "Implemented Standards" table, in its order. */
const standards = [
	{
		label: 'OAuth 2.1',
		href: 'https://datatracker.ietf.org/doc/html/draft-ietf-oauth-v2-1'
	},
	{ label: 'RFC 6749', href: 'https://datatracker.ietf.org/doc/html/rfc6749' },
	{ label: 'RFC 7636', href: 'https://datatracker.ietf.org/doc/html/rfc7636' },
	{ label: 'RFC 7519', href: 'https://datatracker.ietf.org/doc/html/rfc7519' },
	{ label: 'RFC 7517', href: 'https://datatracker.ietf.org/doc/html/rfc7517' },
	{
		label: 'OIDC Core 1.0',
		href: 'https://openid.net/specs/openid-connect-core-1_0.html'
	},
	{
		label: 'OIDC Discovery 1.0',
		href: 'https://openid.net/specs/openid-connect-discovery-1_0.html'
	},
	{ label: 'RFC 9207', href: 'https://datatracker.ietf.org/doc/html/rfc9207' },
	{ label: 'RFC 8707', href: 'https://datatracker.ietf.org/doc/html/rfc8707' },
	{ label: 'RFC 7009', href: 'https://datatracker.ietf.org/doc/html/rfc7009' },
	{ label: 'RFC 7662', href: 'https://datatracker.ietf.org/doc/html/rfc7662' },
	{ label: 'RFC 9701', href: 'https://datatracker.ietf.org/doc/html/rfc9701' },
	{ label: 'RFC 9126', href: 'https://datatracker.ietf.org/doc/html/rfc9126' },
	{ label: 'RFC 9449', href: 'https://datatracker.ietf.org/doc/html/rfc9449' },
	{ label: 'RFC 7591', href: 'https://datatracker.ietf.org/doc/html/rfc7591' },
	{ label: 'RFC 7592', href: 'https://datatracker.ietf.org/doc/html/rfc7592' },
	{ label: 'RFC 8628', href: 'https://datatracker.ietf.org/doc/html/rfc8628' },
	{ label: 'RFC 8705', href: 'https://datatracker.ietf.org/doc/html/rfc8705' },
	{ label: 'RFC 9396', href: 'https://datatracker.ietf.org/doc/html/rfc9396' },
	{ label: 'RFC 9728', href: 'https://datatracker.ietf.org/doc/html/rfc9728' },
	{
		label: 'CIBA',
		href: 'https://openid.net/specs/openid-client-initiated-backchannel-authentication-core-1_0.html'
	},
	{ label: 'JARM', href: 'https://openid.net/specs/oauth-v2-jarm.html' }
];

const transcript = `agent  → settings_update { "deviceFlow.enabled": false }

server ← Nothing has been changed. Change server settings. The merged
         configuration is validated first …

         Target: settings_update
         To proceed, call settings_update again with
         confirmationToken="<token from the first call>".
         It is valid once, until 2026-09-03T14:12:04.000Z.

agent  → settings_update { "deviceFlow.enabled": false,
                           "confirmationToken": "<token from the first call>" }

server ← { "appliedKeys": ["deviceFlow.enabled"],
           "pendingRestartKeys": [], … }

         Audit: actor agent:ops-bot, action settings.update.`;
---

<Site
	title={t.title}
	description={t.description}
	jsonLd={jsonLd}
	locale={locale}
>
	<Section>
		{
			isStale('home', locale) && (
				<StaleTranslationNotice
					locale={locale}
					english="/"
					class="mb-8"
				/>
			)
		}
		<div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2">
			<div>
				<Eyebrow>{t.hero.eyebrow}</Eyebrow>
				<h1 class="text-4xl font-[650] leading-[1.15] tracking-tight text-balance sm:text-5xl">
					{t.hero.heading}
				</h1>
				<p class="mt-5 max-w-prose text-lg text-gray-600 dark:text-gray-400">
					{t.hero.lead}
				</p>
				<!-- The opening has to stand alone: it is the first screen a search visitor sees,
				     and the passage an assistant quotes when asked what this project is. What it is,
				     who runs it and how it is licensed, before any scrolling. -->
				<p class="mt-3 max-w-prose text-lg text-gray-600 dark:text-gray-400">
					<RichText
						text={t.hero.audience(license)}
						codeClass=""
					/>
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<Button
						href={href.getStarted}
						size="lg">{t.hero.getStarted}</Button
					>
					<Button
						href="https://github.com/RedFox-Soft/OAuth-server.ts"
						variant="secondary"
						size="lg">{t.hero.github}</Button
					>
				</div>
				<p class="mt-6 flex flex-wrap items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
					<Badge tone="accent">{t.hero.specifications}</Badge>
					<Badge tone="neutral">Bun + Elysia</Badge>
					<Badge tone="neutral">{license}</Badge>
				</p>
			</div>
			<div class="flex flex-col gap-6 lg:pt-8">
				<figure class="m-0">
					<figcaption
						class="rounded-t-card border border-b-0 border-gray-200 bg-gray-50 px-4 py-2 text-xs font-medium text-gray-600 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400"
					>
						{t.hero.quickstartCaption}
					</figcaption>
					<pre
						class="overflow-x-auto rounded-b-card border border-gray-200 bg-white p-4 font-mono text-sm leading-relaxed text-gray-800 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200"><code>{quickstart}</code></pre>
				</figure>
				<Card>
					<p class="text-sm font-semibold">{t.hero.givesHeading}</p>
					<ul class="mt-3 grid grid-cols-1 gap-2 text-sm text-gray-700 sm:grid-cols-2 dark:text-gray-300">
						{
							t.hero.gives.map(({ head, body }) => (
								<li class="flex gap-2">
									<span
										aria-hidden="true"
										class="text-accent-700 dark:text-accent-200"
									>
										→
									</span>
									<span>
										<span class="font-medium text-gray-900 dark:text-gray-100">{head}</span>
										{' '}
										{body}
									</span>
								</li>
							))
						}
					</ul>
				</Card>
			</div>
		</div>
		<CompareLinks
			class="mt-10 max-w-prose"
			locale={locale}
		/>
	</Section>

	<Section>
		<Eyebrow>{t.console.eyebrow}</Eyebrow>
		<h2 class="text-3xl font-[650] tracking-tight text-balance">
			{t.console.heading}
		</h2>
		<p class="mt-3 max-w-prose text-gray-600 dark:text-gray-400">
			{t.console.lead}
		</p>
		<ScreenshotFigure
			name="admin-project-clients"
			alt={t.console.screenshotAlt}
			caption={t.console.screenshotCaption}
		/>
	</Section>

	<Section tone="muted">
		<Eyebrow>{t.audiences.eyebrow}</Eyebrow>
		<h2 class="text-3xl font-[650] tracking-tight text-balance">
			{t.audiences.heading}
		</h2>
		<p class="mt-3 max-w-prose text-gray-600 dark:text-gray-400">
			{t.audiences.lead}
		</p>
		<div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-3">
			{
				t.audiences.cards.map((audience) => (
					<Card href={href.features}>
						<h3 class="text-lg font-[650] tracking-tight">{audience.title}</h3>
						<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{audience.body}</p>
						<ul class="mt-4 flex flex-col gap-2 text-sm text-gray-700 dark:text-gray-300">
							{audience.points.map((point) => (
								<li class="flex gap-2">
									<span
										aria-hidden="true"
										class="text-accent-700 dark:text-accent-200"
									>
										→
									</span>
									<span>{typeof point === 'function' ? point(facts) : point}</span>
								</li>
							))}
						</ul>
						<p class="mt-4 text-sm font-medium text-accent-700 dark:text-accent-200">
							{t.audiences.seeAll}
						</p>
					</Card>
				))
			}
		</div>
	</Section>

	<Section>
		<Eyebrow>{t.quickStart.eyebrow}</Eyebrow>
		<h2 class="text-3xl font-[650] tracking-tight text-balance">
			{t.quickStart.heading}
		</h2>
		<p class="mt-3 max-w-prose text-gray-600 dark:text-gray-400">
			{t.quickStart.lead}
		</p>
		<div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-3">
			{
				steps.map((step) => (
					<Card href={step.href}>
						<p
							class="font-mono text-sm font-medium text-accent-700 dark:text-accent-200"
							aria-hidden="true"
						>
							{step.n}
						</p>
						<h3 class="mt-2 text-lg font-[650] tracking-tight">{step.title}</h3>
						<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{step.body}</p>
					</Card>
				))
			}
		</div>
	</Section>

	<Section tone="muted">
		<Eyebrow>{t.standards.eyebrow}</Eyebrow>
		<h2 class="text-3xl font-[650] tracking-tight text-balance">
			{t.standards.heading}
		</h2>
		<p class="mt-3 max-w-prose text-gray-600 dark:text-gray-400">
			{t.standards.lead}
		</p>
		<ul class="mt-8 flex flex-wrap gap-2">
			{
				standards.map((standard) => (
					<li>
						<a
							href={standard.href}
							class="no-underline"
						>
							<Badge tone="neutral">{standard.label}</Badge>
						</a>
					</li>
				))
			}
		</ul>
		<p class="mt-6">
			<Button
				href={href.endpoints}
				variant="secondary"
			>
				{t.standards.reference}
			</Button>
		</p>
	</Section>

	<Section>
		<div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2">
			<div>
				<Eyebrow>{t.mcp.eyebrow}</Eyebrow>
				<h2 class="text-3xl font-[650] tracking-tight text-balance">
					{t.mcp.heading}
				</h2>
				<p class="mt-4 max-w-prose text-gray-600 dark:text-gray-400">
					<RichText text={t.mcp.protect} />
				</p>
				<p class="mt-4 max-w-prose text-gray-600 dark:text-gray-400">
					<RichText text={t.mcp.operate(mcpToolCount)} />
				</p>
				<p class="mt-4 max-w-prose text-gray-600 dark:text-gray-400">
					{t.mcp.confirm}
				</p>
				<p class="mt-6 flex flex-wrap gap-3">
					<Button href={href.protectMcp}>
						{t.mcp.protectButton}
					</Button>
					<Button
						href={href.mcpTools}
						variant="secondary"
					>
						{t.mcp.allTools(mcpToolCount)}
					</Button>
				</p>
			</div>
			<pre
				class="overflow-x-auto rounded-card border border-gray-200 bg-gray-50 p-5 font-mono text-xs leading-relaxed text-gray-800 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200">{transcript}</pre>
		</div>
	</Section>

	<Section
		tone="muted"
		narrow
	>
		<Eyebrow>{t.licensing.eyebrow}</Eyebrow>
		<h2 class="text-3xl font-[650] tracking-tight text-balance">
			{t.licensing.heading}
		</h2>
		<p class="mt-4 text-gray-600 dark:text-gray-400">
			{t.licensing.body}
		</p>
		<p class="mt-6">
			<Button
				href={href.license}
				variant="secondary">{t.licensing.read}</Button
			>
		</p>
	</Section>

	<Section>
		<Card
			tone="accent"
			padding="lg"
		>
			<Eyebrow>{t.start.eyebrow}</Eyebrow>
			<h2 class="text-3xl font-[650] tracking-tight text-balance">
				{t.start.heading}
			</h2>
			<p class="mt-3 max-w-prose text-gray-600 dark:text-gray-400">
				{t.start.lead}
			</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<Button
					href={href.getStarted}
					size="lg">{t.start.getStarted}</Button
				>
				<Button
					href={href.docs}
					variant="secondary"
					size="lg">{t.start.docs}</Button
				>
				<Button
					href={href.cloud}
					variant="ghost"
					size="lg"
				>
					{t.start.waitlist}
				</Button>
			</div>
		</Card>
	</Section>
</Site>
