---
import { Code } from '@astrojs/starlight/components';
import { loadExport } from '../data/export.ts';

/*
 * One proxy's configuration, as the console's Connect step builds it (lib/behind_proxy/recipes.ts),
 * for the example addresses the docs export carries: for an app people sign in to (`target="app"`,
 * the default) or for an API whose tokens the proxy checks (`target="api"`). The page never keeps a
 * copy of its own, so the site cannot show a recipe the console does not give (FR-034).
 */
interface Props {
	kind: 'caddy' | 'traefik' | 'nginx';
	target?: 'app' | 'api';
}
const { kind, target = 'app' } = Astro.props;

const behindProxy = loadExport().behindProxy;
const recipes =
	target === 'api' ? behindProxy.api.recipes : behindProxy.recipes;
const recipe = recipes.find((r) => r.kind === kind);
if (!recipe) {
	throw new Error(
		`generated/docs-export.json has no ${kind} recipe for ${target === 'api' ? 'an API' : 'an app'}; run \`bun run generate\``
	);
}

/* Shiki has no Caddyfile grammar; plain text avoids a build warning per page. */
const LANG = { caddy: 'txt', traefik: 'yaml', nginx: 'nginx' } as const;
const TITLE = {
	caddy: 'Caddyfile',
	traefik: 'Traefik dynamic configuration',
	nginx: target === 'api' ? 'nginx configuration' : 'nginx server block'
} as const;
---

<Code
	code={recipe.text}
	lang={LANG[kind]}
	title={TITLE[kind]}
/>
