---
interface Props {
	tone?: 'neutral' | 'accent' | 'flag';
}
const { tone = 'neutral' } = Astro.props;
const tones = {
	neutral: 'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300',
	accent: 'bg-accent-100 text-accent-900 dark:bg-accent-950 dark:text-accent-200',
	flag: 'bg-gray-900 font-mono text-gray-100 dark:bg-gray-100 dark:text-gray-900'
};
---

<span
	class:list={[
		'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium',
		tones[tone]
	]}><slot /></span
>
