{
	"name": "oauth-server-ts",
	"version": "2.1.0",
	"type": "module",
	"license": "FSL-1.1-ALv2",
	"description": "Source-available OAuth 2.1 and OpenID Connect authorization server on Bun, with a built-in admin console and administration over MCP for AI agents.",
	"homepage": "https://foxauth.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RedFox-Soft/OAuth-server.ts.git"
	},
	"bugs": {
		"url": "https://github.com/RedFox-Soft/OAuth-server.ts/issues"
	},
	"keywords": [
		"oauth2",
		"oauth-2.1",
		"oidc",
		"openid-connect",
		"authorization-server",
		"identity-provider",
		"pkce",
		"dpop",
		"fapi",
		"mcp",
		"bun",
		"elysia",
		"typescript"
	],
	"scripts": {
		"format": "prettier --write .",
		"lint": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"build": "bun build.ts",
		"watch": "bun build.ts --watch",
		"db:setup": "bun database/mongodb.ts",
		"db:setup:pg": "bun database/postgres.ts",
		"db:migrate": "bun database/migrate.ts",
		"admin:password-sign-in": "bun database/admin_password_sign_in.ts",
		"admin:replace-root-keys": "bun database/replace_root_keys.ts",
		"keyring": "bun database/keyring.ts",
		"docs:export": "bun scripts/docs_export.ts",
		"start": "bun lib/index.ts"
	},
	"dependencies": {
		"@ant-design/colors": "^8.0.1",
		"@ant-design/cssinjs": "~2.2.0",
		"@ant-design/icons": "^6.3.4",
		"@elysiajs/static": "^1.4.12",
		"@modelcontextprotocol/server": "^2.4.0",
		"@rc-component/qrcode": "2.0.0",
		"@sentry/bun": "11.19.0",
		"@simplewebauthn/browser": "14.0.0",
		"@simplewebauthn/server": "14.1.0",
		"antd": "^6.7.2",
		"debug": "^4.4.3",
		"elysia": "^1.4.32",
		"jose": "^6.2.18",
		"jsesc": "^3.1.0",
		"mongodb": "^7.9.1",
		"nanoid": "^6.0.2",
		"nodemailer": "^10.6.1",
		"quick-lru": "^8.0.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@elysiajs/eden": "^1.4.9",
		"@eslint/js": "^10.0.1",
		"@modelcontextprotocol/client": "^2.4.0",
		"@types/bun": "^1.4.5",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"desm": "^1.3.1",
		"eslint": "^10.15.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"fast-check": "^4.11.0",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"moment": "^2.31.0",
		"openid-client": "^6.9.1",
		"prettier": "^3.10.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0"
	},
	"patchedDependencies": {
		"bun-types@1.4.5": "patches/bun-types@1.4.5.patch"
	}
}
