{
	"name": "oauth-server-ts",
	"version": "0.2.0",
	"type": "module",
	"license": "FSL-1.1-ALv2",
	"description": "Source-available OAuth 2.1 and OpenID Connect authorization server on Bun, with a built-in admin console and administration over MCP for AI agents.",
	"homepage": "https://foxauth.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RedFox-Soft/OAuth-server.ts.git"
	},
	"bugs": {
		"url": "https://github.com/RedFox-Soft/OAuth-server.ts/issues"
	},
	"keywords": [
		"oauth2",
		"oauth-2.1",
		"oidc",
		"openid-connect",
		"authorization-server",
		"identity-provider",
		"pkce",
		"dpop",
		"fapi",
		"mcp",
		"bun",
		"elysia",
		"typescript"
	],
	"scripts": {
		"format": "prettier --write .",
		"lint": "eslint lib test --fix",
		"typecheck": "tsc --noEmit",
		"build": "bun build.ts",
		"watch": "bun build.ts --watch",
		"db:setup": "bun database/mongodb.ts",
		"db:setup:pg": "bun database/postgres.ts",
		"db:migrate": "bun database/migrate.ts",
		"docs:export": "bun scripts/docs_export.ts",
		"start": "bun lib/index.ts"
	},
	"dependencies": {
		"@ant-design/cssinjs": "^2.1.2",
		"@ant-design/icons": "^6.3.4",
		"@elysiajs/static": "^1.4.10",
		"@modelcontextprotocol/server": "^2.0.0",
		"@sentry/bun": "10.73.0",
		"antd": "^6.6.2",
		"debug": "^4.4.3",
		"elysia": "^1.4.30",
		"jose": "^6.2.12",
		"jsesc": "^3.1.0",
		"mongodb": "^7.6.0",
		"nanoid": "^6.0.1",
		"nodemailer": "^10.0.0",
		"quick-lru": "^7.3.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@elysiajs/eden": "^1.4.9",
		"@eslint/js": "^10.0.1",
		"@modelcontextprotocol/client": "^2.0.0",
		"@types/bun": "^1.4.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"base64url": "^3.0.1",
		"desm": "^1.3.1",
		"eslint": "^10.10.0",
		"fast-check": "^4.9.0",
		"jiti": "^2.7.0",
		"lodash": "^4.18.1",
		"moment": "^2.30.1",
		"openid-client": "^6.8.8",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0"
	}
}
