---
import RichText from '../RichText.astro';
import english from '../../i18n/messages/guide/en.ts';
import type {
	GuideQuestionEntry,
	GuideSituationEntry
} from '../../data/export.ts';
import type { GuideTexts } from '../../i18n/guide-texts.ts';

/*
 * The first tab's two questions, as plain radio groups, and its common tasks, as links. Question 1 only decides which
 * list of question 2 is shown; every answer of question 2 is in one group (`guide-product`). A common task is a link
 * to its answer (`#answer-<id>`), so each is its own tab stop and a radio group never mixes the two kinds. With
 * scripts off the choice works through CSS and `:target` (see Guide.astro); the script turns a task's link into the
 * tab's choice, and adds the memory of each actor's last answer and the address.
 */
interface Props {
	questions: GuideQuestionEntry[];
	chips: GuideSituationEntry[];
	texts: GuideTexts;
	t: typeof english;
	actor: string;
	chosen: string;
}
const { questions, chips, texts, t, actor, chosen } = Astro.props;

const option =
	'flex min-w-0 cursor-pointer items-start gap-3 rounded-control border border-gray-200 bg-white p-3 transition-colors hover:border-accent-500 has-[:checked]:border-accent-500 has-[:checked]:bg-accent-50 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-accent-500 dark:border-gray-700 dark:bg-gray-800 dark:has-[:checked]:border-accent-400 dark:has-[:checked]:bg-accent-950';
const radio = 'mt-1 size-4 shrink-0 accent-accent-600';
const legend =
	'mb-3 flex items-center gap-2 p-0 text-base font-semibold text-gray-950 dark:text-white';
const number =
	'grid size-6 shrink-0 place-items-center rounded-full bg-gray-900 text-xs font-bold text-gray-50 dark:bg-gray-100 dark:text-gray-900';
---

<div class="flex flex-col gap-8">
	<fieldset class="m-0 min-w-0 border-0 p-0">
		<legend class={legend}>
			<span class={number} aria-hidden="true">1</span>
			{t.questions.first}
		</legend>
		<div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
			{
				questions.map((q) => (
					<label class={option}>
						<input
							type="radio"
							name="guide-actor"
							id={`g-actor-${q.actor}`}
							value={q.actor}
							checked={q.actor === actor}
							class={radio}
						/>
						<span class="min-w-0">
							<span class="block font-semibold text-gray-950 dark:text-white">
								{texts.questions[q.actor].title}
							</span>
							<span class="hidden text-sm text-gray-600 sm:block dark:text-gray-400">
								{texts.questions[q.actor].sub}
							</span>
						</span>
					</label>
				))
			}
		</div>
	</fieldset>

	{
		questions.map((q) => (
			<fieldset
				class="g-q2 m-0 min-w-0 border-0 p-0"
				id={`g-q2-${q.actor}`}
			>
				<legend class={legend}>
					<span class={number} aria-hidden="true">
						2
					</span>
					{texts.questions[q.actor].second}
				</legend>
				<div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
					{q.answers.map((answer, i) => (
						<label class={option}>
							<input
								type="radio"
								name="guide-product"
								id={`g-s-${answer.answer}`}
								value={answer.answer}
								checked={answer.answer === chosen}
								class:list={[radio, `g-ans-${q.actor}`]}
								data-actor={q.actor}
								data-first={i === 0 ? '' : undefined}
							/>
							<span class="min-w-0">
								<span class="block font-semibold text-gray-950 dark:text-white">
									{texts.questions[q.actor].answers[answer.answer]?.title}
								</span>
								<span class="block text-sm text-gray-600 dark:text-gray-400">
									{texts.questions[q.actor].answers[answer.answer]?.sub}
								</span>
							</span>
						</label>
					))}
				</div>
				{q.actor === 'agent' && (
					<p class="mt-3 text-sm text-gray-700 dark:text-gray-300">
						<RichText text={t.questions.agentNative} />
					</p>
				)}
			</fieldset>
		))
	}

	<div class="min-w-0">
		<p
			id="g-more-tasks"
			class="mb-1 text-base font-semibold text-gray-950 dark:text-white"
		>
			{t.questions.moreTasks}
		</p>
		<p class="mb-3 text-sm text-gray-600 dark:text-gray-400">
			{t.questions.moreTasksSub}
		</p>
		<ul
			aria-labelledby="g-more-tasks"
			class="m-0 flex list-none flex-wrap gap-2 p-0"
		>
			{
				chips.map((chip) => (
					<li class="m-0 min-w-0 max-w-full">
						<a
							href={`#answer-${chip.id}`}
							data-chip={chip.id}
							class="g-chip inline-flex min-w-0 max-w-full items-center rounded-full border border-gray-300 bg-white px-3 py-1.5 text-sm text-gray-900 no-underline transition-colors hover:border-accent-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100"
						>
							<span class="min-w-0 [overflow-wrap:anywhere]">
								{texts.situations[chip.id]?.title}
							</span>
						</a>
					</li>
				))
			}
		</ul>
		<p class="g-target-hint mt-3 text-sm text-gray-700 dark:text-gray-300">
			<RichText text={t.questions.backToQuestions} />
		</p>
	</div>
</div>
