{
	"name": "website",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "bun --bun astro dev",
		"generate": "bun scripts/generate.ts",
		"seo": "bun scripts/postbuild.ts && bun scripts/i18n/freshness.ts",
		"i18n:stamp": "bun scripts/i18n/stamp.ts",
		"build": "bun run generate && bun --bun astro build && bun run seo",
		"preview": "bun --bun astro preview",
		"check": "bun --bun astro check"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "^0.4.5",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/starlight": "^0.42.6",
		"@astrojs/starlight-tailwind": "^5.0.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.4.2",
		"marked": "^18.1.1",
		"sharp": "^0.35.5",
		"starlight-links-validator": "^0.27.0",
		"starlight-llms-txt": "^0.12.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@fontsource/noto-sans-sc": "^5.3.1",
		"@types/bun": "^1.4.4",
		"playwright": "^1.64.1",
		"typescript": "^6.0.3"
	}
}
