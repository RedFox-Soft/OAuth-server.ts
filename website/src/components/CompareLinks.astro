---
/*
 * Links to every comparison, from the collection rather than a hand-kept list.
 *
 * The comparison pages target the highest commercial-intent queries this project can win — "Keycloak
 * alternative", "self-hosted Auth0 alternative" — and each was linked from exactly one place, the
 * /compare/ index, against twelve to thirty for every other page. That was not a decision; it was
 * three files nobody remembered to update. Reading the collection means a new comparison appears at
 * every call site the moment its .mdx exists.
 *
 * The anchor text is the competitor's name, always. "Read more" tells a search engine nothing about
 * what is on the other end, and tells a reader scanning the page nothing either.
 */
import { getCollection } from 'astro:content';
import { chrome } from '../i18n/chrome.ts';
import type { LocaleKey } from '../data/seo.ts';
import { listParts } from '../data/storage.ts';

interface Props {
	/* `prose` reads as a sentence inside body copy; `list` is a plain set of links. */
	variant?: 'prose' | 'list';
	class?: string;
	locale?: LocaleKey;
}
const { variant = 'prose', class: className, locale = 'en' } = Astro.props;
const t = chrome(locale).compareLinks;

const entries = (await getCollection('compare')).sort((a, b) =>
	a.data.competitor.localeCompare(b.data.competitor)
);

/*
 * Comparison articles are English-only, so the links always point at the English pages. In another
 * language the names are joined the way that language lists things («A, B и C», «A、B 和 C»), which
 * Intl.ListFormat knows and a hard-coded ", " and " and " does not.
 */
const parts =
	locale === 'en'
		? undefined
		: listParts(
				entries.map((entry) => entry.id),
				'conjunction',
				locale
			);
const byId = new Map(entries.map((entry) => [entry.id, entry]));

const linkClass =
	'font-medium text-accent-700 underline underline-offset-2 hover:text-accent-800 dark:text-accent-200 dark:hover:text-accent-100';
---

{
	variant === 'prose' && parts ? (
		<p class:list={['text-gray-600 dark:text-gray-400', className]}>
			{t.before}{' '}
			{parts.map((part) =>
				part.type === 'element' ? (
					<a
						href={`/compare/${part.value}/`}
						class={linkClass}
					>
						{byId.get(part.value)?.data.competitor}
					</a>
				) : (
					part.value
				)
			)}
			{t.after}
		</p>
	) : variant === 'prose' ? (
		<p class:list={['text-gray-600 dark:text-gray-400', className]}>
			{t.before}{' '}
			{entries.map((entry, index) => (
				<Fragment>
					<a
						href={`/compare/${entry.id}/`}
						class={linkClass}
					>
						{entry.data.competitor}
					</a>
					{index < entries.length - 2 ? ', ' : index === entries.length - 2 ? ' and ' : ''}
				</Fragment>
			))}
			{t.after}
		</p>
	) : (
		<ul class:list={['flex flex-col gap-1', className]}>
			{entries.map((entry) => (
				<li>
					<a
						href={`/compare/${entry.id}/`}
						class={linkClass}
					>
						{entry.data.competitor}
					</a>
				</li>
			))}
		</ul>
	)
}
