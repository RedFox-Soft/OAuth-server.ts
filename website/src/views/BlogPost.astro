---
import { render } from 'astro:content';
import Site from '../layouts/Site.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import StaleTranslationNotice from '../components/StaleTranslationNotice.astro';
import { LOCALE_DEFINITIONS, SITE_ORIGIN, type LocaleKey } from '../data/seo.ts';
import { blogPosting } from '../data/structured.ts';
import { effectiveDate, type BlogPost } from '../data/blog.ts';
import { localizedHref, localizedRoute } from '../i18n/locale.ts';
import { messagesFor } from '../i18n/messages.ts';
import english from '../i18n/messages/blog/en.ts';
import { ageInDays, isStale } from '../../scripts/seo/freshness.ts';

interface Props {
	post: BlogPost;
	locale: LocaleKey;
}
const { post, locale } = Astro.props;
const t = messagesFor('blog', english, locale);
const { Content } = await render(post.entry);
const { title, description, publishedAt, updatedAt } = post.data;
const route = localizedRoute(`/blog/${post.slug}/`, locale);

/*
 * `headline` is the visible h1 verbatim, because the guardrail checks every claimed string against
 * the rendered text. Paraphrasing it here would fail the build, which is the intended outcome.
 */
const jsonLd = blogPosting({
	headline: title,
	description,
	canonical: new URL(route, SITE_ORIGIN).href,
	datePublished: publishedAt,
	dateModified: updatedAt,
	inLanguage: LOCALE_DEFINITIONS[locale].lang
});

/*
 * Past the freshness limit the article tells the reader so, in place of nothing. It never fails the
 * build: an article going out of date is the passage of time rather than a mistake somebody made,
 * and a build that breaks because nobody reread a two-year-old post blocks work that has nothing to
 * do with it. The notice on the page is the signal with teeth — the same reasoning the comparison
 * pages already run on.
 */
const dated = effectiveDate(post);
const aged = isStale(dated);
const agedDays = ageInDays(dated);
const guide = await localizedHref('/docs/get-started/docker-compose/', locale);
---

<Site
	title={`${title} — FoxAuth`}
	description={description}
	jsonLd={jsonLd}
	breadcrumbLeaf={title}
	locale={locale}
>
	<Section narrow>
		<Eyebrow>{t.eyebrow}</Eyebrow>
		<h1 class="text-4xl font-[650] leading-[1.15] tracking-tight text-balance">{title}</h1>
		<p class="mt-5 text-lg text-gray-600 dark:text-gray-400">{description}</p>
		<p class="mt-5 text-sm text-gray-500 dark:text-gray-400">
			{t.post.by}{' '}
			<span class="font-medium text-gray-700 dark:text-gray-300">FoxAuth</span>{' · '}
			<time datetime={publishedAt}>{publishedAt}</time>
			{
				updatedAt && updatedAt !== publishedAt && (
					<Fragment>
						{t.post.updated}
						<time datetime={updatedAt}>{updatedAt}</time>
					</Fragment>
				)
			}
		</p>
		{
			post.data.storageScope && (
				<p
					data-storage-scope={post.data.storageScope}
					class="mt-4 rounded-card border border-gray-200 bg-gray-50 p-4 text-sm text-gray-600 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400"
				>
					{t.post.storageScope(post.data.storageScope)}
				</p>
			)
		}
		{
			post.stale && (
				<StaleTranslationNotice
					locale={locale}
					english={`/blog/${post.slug}/`}
					class="mt-4"
				/>
			)
		}
		{
			aged && (
				<p class="mt-4 rounded-card border border-accent-300 bg-accent-50 p-4 text-sm text-gray-700 dark:border-accent-700 dark:bg-accent-950 dark:text-gray-200">
					<strong>{t.post.agedHeading}</strong>
					{t.post.aged(agedDays)}
				</p>
			)
		}
	</Section>

	<Section
		narrow
		tone="muted"
	>
		<div class="prose max-w-none dark:prose-invert">
			<Content />
		</div>
	</Section>

	<Section narrow>
		<div class="flex flex-wrap gap-3">
			<Button
				href={localizedRoute('/blog/', locale)}
				variant="secondary">{t.post.allArticles}</Button
			>
			<Button href={guide}>{t.post.tryIt}</Button>
		</div>
	</Section>
</Site>
