---
import { getCollection } from 'astro:content';
import Brand from './Brand.astro';
import { loadVersion } from '../data/version';
import { chrome } from '../i18n/chrome.ts';
import { localizedHref, localizedRoute } from '../i18n/locale.ts';
import type { LocaleKey } from '../data/seo.ts';

interface Props {
	locale?: LocaleKey;
}
const { locale = 'en' } = Astro.props;
const t = chrome(locale).footer;
const v = loadVersion();

/*
 * The comparisons are listed individually rather than behind one "Compare" link. They target the
 * queries with the most commercial intent on the site and had a single inbound link each; naming
 * them here gives every one a site-wide link whose anchor text is the product a reader is searching
 * for. Read from the collection, so a new comparison appears without editing this file.
 */
const comparisons = (await getCollection('compare'))
	.sort((a, b) => a.data.competitor.localeCompare(b.data.competitor))
	.map((entry) => ({ href: `/compare/${entry.id}/`, label: entry.data.competitor }));

const columns = await Promise.all(
	[
		{
			heading: t.product,
			links: [
				{ href: '/features/', label: t.features },
				{ href: '/pricing/', label: t.pricing },
				{ href: '/compare/', label: t.compare },
				{ href: '/blog/', label: t.blog },
				...comparisons
			]
		},
		{
			heading: t.docs,
			links: [
				{ href: '/docs/get-started/docker-compose/', label: t.getStarted },
				{ href: '/docs/deploy/docker-compose/', label: t.deploy },
				{ href: '/docs/reference/settings/', label: t.reference }
			]
		},
		{
			heading: t.project,
			links: [
				{ href: 'https://github.com/RedFox-Soft/OAuth-server.ts', label: t.github },
				{ href: '/changelog/', label: t.changelog },
				{ href: '/security/', label: t.security },
				{ href: '/license/', label: t.license },
				{ href: '/blog/rss.xml', label: t.feed },
				{ href: '/llms.txt', label: t.llms }
			]
		},
		{
			heading: t.contact,
			links: [
				{ href: '/contact/', label: t.contactUs },
				{ href: 'mailto:hello@foxauth.dev', label: 'hello@foxauth.dev' }
			]
		}
	].map(async (column) => ({
		...column,
		links: await Promise.all(
			column.links.map(async (link) => ({ ...link, href: await localizedHref(link.href, locale) }))
		)
	}))
);
---

<footer class="border-t border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-900">
	<div class="mx-auto max-w-6xl px-6 py-12">
		<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
			{
				columns.map((column) => (
					<div>
						<h2 class="mb-3 text-sm font-[650] text-gray-900 dark:text-gray-100">
							{column.heading}
						</h2>
						<ul class="flex flex-col gap-2">
							{column.links.map((link) => (
								<li>
									<a
										href={link.href}
										class="text-sm text-gray-600 transition-colors hover:text-accent-700 dark:text-gray-400 dark:hover:text-accent-200"
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<div
			class="mt-10 flex flex-col gap-4 border-t border-gray-200 pt-6 dark:border-gray-800 sm:flex-row sm:items-center sm:justify-between"
		>
			<Brand
				size={24}
				href={localizedRoute('/', locale)}
			/>
			<div class="text-sm text-gray-600 dark:text-gray-400">
				<p>{t.about}</p>
				<p class="mt-1">{t.siteVersion(v.version, v.unreleased)}</p>
			</div>
		</div>
	</div>
</footer>
