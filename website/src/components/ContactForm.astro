---
import Button from './ui/Button.astro';
import RichText from './RichText.astro';
import { messagesFor } from '../i18n/messages.ts';
import english from '../i18n/messages/forms/en.ts';
import type { LocaleKey } from '../data/seo.ts';

interface Props {
	/* Prefills Formspree's _subject, and the mailto subject in the unconfigured fallback. */
	subject?: string;
	locale?: LocaleKey;
}
const { subject: baseSubject = 'FoxAuth enquiry', locale = 'en' } = Astro.props;
const t = messagesFor('forms', english, locale);
/* The subject stays English because the team's inbox reads it; the tag says which page it came from. */
const subject = locale === 'en' ? baseSubject : `${baseSubject} [${locale}]`;
const address = 'hello@foxauth.dev';
const formId = import.meta.env.PUBLIC_FORMSPREE_CONTACT;
const fieldClass =
	'w-full rounded-control border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 placeholder:text-gray-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100';
---

{
	formId ? (
		<form method="POST" action={`https://formspree.io/f/${formId}`} class="flex flex-col gap-3">
			<input type="hidden" name="_subject" value={subject} />
			<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" />
			<label class="flex flex-col gap-1 text-sm font-medium">
				{t.workEmail}
				<input
					type="email"
					name="email"
					required
					autocomplete="email"
					placeholder={t.emailPlaceholder}
					class={fieldClass}
				/>
			</label>
			<label class="flex flex-col gap-1 text-sm font-medium">
				{t.contact.need}
				<textarea
					name="message"
					required
					rows="4"
					placeholder={t.contact.needPlaceholder}
					class={fieldClass}></textarea>
			</label>
			<Button type="submit">{t.contact.send}</Button>
			<p class="text-xs text-gray-600 dark:text-gray-400">{t.contact.reassurance}</p>
		</form>
	) : (
		<p class="text-sm text-gray-600 dark:text-gray-400">
			<RichText text={t.contact.fallback(address, `mailto:${address}?subject=${encodeURIComponent(subject)}`)} />
		</p>
	)
}
