---
import Part from './Part.astro';
import english from '../../i18n/messages/guide/en.ts';
import { loadExport } from '../../data/export.ts';
import { CLOUD_CONSOLE } from '../../data/cloud.ts';

/*
 * A drawn hint of the screen the person meets, not a screenshot, with the example names the console's guide uses
 * (GUIDE_EXAMPLES, through the export): the app is Acme Notes, the company Acme Corp, the agent Claude, the outside
 * service Google; the agent managing FoxAuth itself meets FoxAuth's own console instead of the app. Names stand
 * on their own line or between the two halves of a sentence each language words itself, so no sentence is a
 * template. Decoration: the lines beside it say the same in words.
 */
interface Props {
	kind:
		| 'signIn'
		| 'signUp'
		| 'companySignIn'
		| 'consent'
		| 'agentConsent'
		| 'adminConsent'
		| 'serviceConsent'
		| 'deviceCode'
		| 'approve'
		| 'none';
	t: (typeof english)['mini'];
}
const { kind, t } = Astro.props;
const examples = loadExport().situationGuide.examples;
const host =
	kind === 'adminConsent'
		? new URL(CLOUD_CONSOLE).host
		: `auth.${examples.app.toLowerCase().replaceAll(' ', '-')}.app`;
const initial = examples.app.slice(0, 1);
---

{
	kind !== 'none' && (
		<div class="g-ms" aria-hidden="true">
			<div class="g-ms-bar">
				<span class="g-ms-dots">
					<i />
					<i />
					<i />
				</span>
				<span class="g-ms-host">{kind === 'approve' ? '' : host}</span>
			</div>
			<div class="g-ms-in">
				{kind === 'adminConsent' ? (
					<div class="g-ms-brand">
						<span class="g-ms-logo g-ms-logo--fox">
							<Part part="fox" strokeWidth={2} />
						</span>
						<span>{t.adminConsent.brand}</span>
					</div>
				) : (
					kind !== 'approve' &&
					kind !== 'deviceCode' && (
						<div class="g-ms-brand">
							<span class="g-ms-logo">{initial}</span>
							<span>{examples.app}</span>
						</div>
					)
				)}
				{kind === 'signUp' && (
					<>
						<div class="g-ms-h">{t.signUp.heading}</div>
						<div class="g-ms-f">{t.signIn.email}</div>
						<div class="g-ms-f">{t.signIn.password}</div>
						<div class="g-ms-b g-ms-b--p">{t.signUp.submit}</div>
						<div class="g-ms-t g-ms-center">{t.signUp.haveAccount}</div>
					</>
				)}
				{kind === 'adminConsent' && (
					<>
						<div class="g-ms-who">
							<Part part="agent" />
							<span>
								<b>{examples.agent}</b>
								<span class="g-ms-t">{t.adminConsent.asks}</span>
							</span>
						</div>
						<ul class="g-ms-perm">
							{t.adminConsent.scopes.map((scope) => (
								<li>
									<Part strokeWidth={2.5} />
									{scope}
								</li>
							))}
						</ul>
						<div class="g-ms-row">
							<div class="g-ms-b g-ms-b--s">{t.consent.deny}</div>
							<div class="g-ms-b g-ms-b--p">{t.consent.allow}</div>
						</div>
					</>
				)}
				{kind === 'serviceConsent' && (
					<>
						<div class="g-ms-who">
							<Part part="cloud" />
							<span>
								<b>{examples.service}</b>
								<span class="g-ms-t">{t.serviceConsent.connect}</span>
							</span>
						</div>
						<div class="g-ms-t">{t.serviceConsent.body}</div>
						<div class="g-ms-row">
							<div class="g-ms-b g-ms-b--s">{t.serviceConsent.cancel}</div>
							<div class="g-ms-b g-ms-b--p">{t.serviceConsent.allow}</div>
						</div>
					</>
				)}
				{kind === 'signIn' && (
					<>
						<div class="g-ms-h">{t.signIn.heading}</div>
						<div class="g-ms-f">{t.signIn.email}</div>
						<div class="g-ms-f">{t.signIn.password}</div>
						<div class="g-ms-b g-ms-b--p">{t.signIn.submit}</div>
						<div class="g-ms-or">{t.signIn.or}</div>
						<div class="g-ms-b g-ms-b--s">{t.signIn.provider}</div>
					</>
				)}
				{kind === 'companySignIn' && (
					<>
						<div class="g-ms-h">{t.signIn.heading}</div>
						<div class="g-ms-b g-ms-b--p g-ms-b--icon">
							<Part part="company" strokeWidth={2} />
							<span>
								{t.companySignIn.before}
								<b>{examples.company}</b>
								{t.companySignIn.after}
							</span>
						</div>
						<div class="g-ms-or">{t.signIn.or}</div>
						<div class="g-ms-f">{t.signIn.email}</div>
						<div class="g-ms-f">{t.signIn.password}</div>
					</>
				)}
				{kind === 'consent' && (
					<>
						<div class="g-ms-h">{t.consent.heading}</div>
						<div class="g-ms-t">{t.consent.body}</div>
						<div class="g-ms-row">
							<div class="g-ms-b g-ms-b--s">{t.consent.deny}</div>
							<div class="g-ms-b g-ms-b--p">{t.consent.allow}</div>
						</div>
					</>
				)}
				{kind === 'agentConsent' && (
					<>
						<div class="g-ms-who">
							<Part part="agent" />
							<span>
								<b>{examples.agent}</b>
								<span class="g-ms-t">{t.agentConsent.asks}</span>
							</span>
						</div>
						<ul class="g-ms-perm">
							{t.agentConsent.scopes.map((scope) => (
								<li>
									<Part strokeWidth={2.5} />
									{scope}
								</li>
							))}
						</ul>
						<div class="g-ms-row">
							<div class="g-ms-b g-ms-b--s">{t.consent.deny}</div>
							<div class="g-ms-b g-ms-b--p">{t.consent.allow}</div>
						</div>
					</>
				)}
				{kind === 'deviceCode' && (
					<>
						<div class="g-ms-who">
							<Part part="tv" />
							<span class="g-ms-t">{t.deviceCode.heading}</span>
						</div>
						<div class="g-ms-code">{t.deviceCode.code}</div>
						<div class="g-ms-b g-ms-b--p">{t.deviceCode.submit}</div>
					</>
				)}
				{kind === 'approve' && (
					<>
						<div class="g-ms-who">
							<Part part="phone" />
							<span class="g-ms-h">{t.approve.heading}</span>
						</div>
						<div class="g-ms-t">{t.approve.body}</div>
						<div class="g-ms-row">
							<div class="g-ms-b g-ms-b--s">{t.approve.decline}</div>
							<div class="g-ms-b g-ms-b--p">{t.approve.approve}</div>
						</div>
					</>
				)}
			</div>
		</div>
	)
}

<style is:global>
	.g-ms {
		width: 100%;
		max-width: 16rem;
		overflow: hidden;
		border: 1px solid var(--g-ms-border);
		border-radius: 0.75rem;
		background: var(--g-ms-bg);
		box-shadow:
			0 1px 2px rgb(31 28 25 / 0.06),
			0 8px 24px -10px rgb(31 28 25 / 0.18);
	}
	.g-ms-bar {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.375rem 0.625rem;
		border-bottom: 1px solid var(--g-border);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		color: var(--g-text-3);
	}
	.g-ms-dots {
		display: flex;
		gap: 0.2rem;
	}
	.g-ms-dots i {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 999px;
		background: var(--g-tile-border);
	}
	.g-ms-host {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.g-ms-in {
		display: grid;
		gap: 0.4rem;
		padding: 0.75rem 0.875rem 0.875rem;
	}
	.g-ms-brand {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--g-text-2);
	}
	.g-ms-logo {
		display: grid;
		place-items: center;
		width: 1.25rem;
		height: 1.25rem;
		border-radius: 0.3rem;
		background: #2f6f5e;
		color: #fff;
		font-size: 0.6875rem;
		font-weight: 700;
	}
	.g-ms-logo--fox {
		background: var(--g-fox-bg);
		color: var(--g-fox-icon);
		box-shadow: inset 0 0 0 1.5px var(--g-fox-border);
	}
	.g-ms-logo--fox .g-glyph {
		width: 0.875rem;
		height: 0.875rem;
	}
	.g-ms-center {
		text-align: center;
	}
	.g-ms-h {
		font-size: 0.875rem;
		font-weight: 650;
		line-height: 1.25;
		color: var(--g-text-strong);
	}
	.g-ms-t {
		display: block;
		font-size: 0.75rem;
		line-height: 1.35;
		color: var(--g-text-2);
	}
	.g-ms-f {
		padding: 0.3rem 0.5rem;
		border: 1px solid var(--g-tile-border);
		border-radius: 0.375rem;
		font-size: 0.75rem;
		color: var(--g-text-3);
	}
	.g-ms-b {
		padding: 0.35rem 0.5rem;
		border-radius: 0.375rem;
		font-size: 0.75rem;
		font-weight: 600;
		line-height: 1.25;
		text-align: center;
	}
	.g-ms-b b {
		font-weight: 700;
	}
	.g-ms-b--p {
		background: var(--color-accent-500);
		color: var(--color-gray-950);
	}
	.g-ms-b--s {
		border: 1px solid var(--g-tile-border);
		color: var(--g-text);
	}
	.g-ms-b--icon {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
	}
	.g-ms-b--icon .g-glyph {
		flex: none;
		width: 1rem;
		height: 1rem;
	}
	.g-ms-or {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.6875rem;
		color: var(--g-text-3);
	}
	.g-ms-or::before,
	.g-ms-or::after {
		content: '';
		flex: 1;
		height: 1px;
		background: var(--g-border);
	}
	.g-ms-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 0.4rem;
	}
	.g-ms-who {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.5rem;
		border-radius: 0.5rem;
		background: var(--g-muted);
		font-size: 0.8125rem;
		line-height: 1.3;
		color: var(--g-text);
	}
	.g-ms-who > .g-glyph {
		flex: none;
		width: 1.375rem;
		height: 1.375rem;
	}
	.g-ms-who b {
		font-weight: 650;
	}
	.g-ms-perm {
		display: grid;
		gap: 0.25rem;
		font-size: 0.75rem;
		color: var(--g-text-2);
	}
	.g-ms-perm li {
		display: flex;
		align-items: center;
		gap: 0.375rem;
	}
	.g-ms-perm .g-glyph {
		flex: none;
		width: 0.8125rem;
		height: 0.8125rem;
		color: var(--g-good);
	}
	.g-ms-code {
		padding-block: 0.25rem;
		font-family: var(--font-mono);
		font-size: 1.0625rem;
		letter-spacing: 0.18em;
		text-align: center;
		color: var(--g-text-strong);
	}
</style>
