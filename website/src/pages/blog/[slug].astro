---
import type { GetStaticPaths } from 'astro';
import BlogPost from '../../views/BlogPost.astro';
import { publishedPosts, type BlogPost as Post } from '../../data/blog.ts';

/*
 * Paths come from publishedPosts() rather than getCollection('blog'), which is what makes a draft —
 * or a post still waiting for its translations — have no page at all rather than an unlisted one.
 */
export const getStaticPaths: GetStaticPaths = async () =>
	(await publishedPosts('en')).map((post) => ({ params: { slug: post.slug }, props: { post } }));

interface Props {
	post: Post;
}
const { post } = Astro.props;
---

<BlogPost
	post={post}
	locale="en"
/>
