---
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';

/*
 * The screenshots are generated (website/public/screenshots/ is gitignored and produced by
 * scripts/capture.ts). A page references one by name and the figure simply disappears when the
 * file is absent, so a build without the capture step still succeeds — rather than shipping a
 * broken <img>. Same cwd assumption as data/version.ts: every documented command runs in website/.
 */
interface Props {
	name: string;
	alt: string;
	caption?: string;
}
const { name, alt, caption } = Astro.props;
const src = `/screenshots/${name}.png`;
const file = resolve(process.cwd(), 'public', `screenshots/${name}.png`);
const present = existsSync(file);
// Read from the PNG header (IHDR: width and height are big-endian u32 at bytes 16 and 20) so the
// intrinsic size follows whatever the capture produced and the browser reserves the right space.
const header = present ? readFileSync(file).subarray(0, 24) : undefined;
const width = header ? header.readUInt32BE(16) : 1440;
const height = header ? header.readUInt32BE(20) : 900;
---

{
	present && (
		<figure class="m-0">
			<img
				src={src}
				alt={alt}
				width={width}
				height={height}
				loading="lazy"
				decoding="async"
				class="w-full rounded-frame border border-gray-200 bg-white dark:border-gray-700"
			/>
			{caption && (
				<figcaption class="mt-2 text-sm text-gray-600 dark:text-gray-400">{caption}</figcaption>
			)}
		</figure>
	)
}
