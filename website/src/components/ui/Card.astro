---
interface Props {
	href?: string;
	tone?: 'default' | 'accent';
}
const { href, tone = 'default' } = Astro.props;
const Tag = href ? 'a' : 'div';
const tones = {
	default: 'border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900',
	accent: 'border-accent-200 bg-accent-50 dark:border-accent-900 dark:bg-gray-900'
};
---

<Tag
	href={href}
	class:list={[
		'block rounded-card border p-6 no-underline transition-colors',
		tones[tone],
		href && 'hover:border-accent-500'
	]}
>
	<slot />
</Tag>
